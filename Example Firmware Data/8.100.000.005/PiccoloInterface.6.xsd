<?xml version="1.0" encoding="utf-8"?>

<!--Schema for validating PiccoloInterface.xml used by Inspire and Steal-->
<!--Should we rename this file? (i.e. PiccoloInterface) and if so does that make it version 0 again?-->

<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ns0="Starkey.FWE.PiccoloInterface.6"
           targetNamespace="Starkey.FWE.PiccoloInterface.6">

  <xs:element name="LogicalParameterInterface">
    <xs:complexType>
      <xs:all>
        <xs:element name="DeviceClass" maxOccurs="1" type="ns0:DeviceClassType"/>
      </xs:all>
      <xs:attributeGroup ref="ns0:node-id"/>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="DeviceClassType">
    <xs:all>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name="LpiFamily" maxOccurs="1" type="ns0:LpiFamilyType"/>
    </xs:all>
    <xs:attributeGroup ref="ns0:name_id"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="LpiFamilyType">
    <xs:all>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name ="LpiConfiguration" type="ns0:LpiConfigurationType" maxOccurs="1">
      </xs:element>
    </xs:all>
    <xs:attributeGroup ref="ns0:name_id"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="LpiConfigurationType">
    <xs:all>
      <xs:element name="ContextCollection">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Context" minOccurs="0" maxOccurs="unbounded" type="ns0:ContextType"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="ParameterGroupCollection">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ParameterGroup" minOccurs="0" maxOccurs="unbounded" type="ns0:ParameterGroupType"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="EnumerationDefinitionCollection">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="EnumerationDefinition" minOccurs="0" maxOccurs="unbounded" type="ns0:EnumerationDefinitionType"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:all>
    <xs:attributeGroup ref="ns0:version_revision_identifier"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  
  <xs:complexType name="ContextType">
    <xs:all>
      <xs:element name="AfsFile" type="xs:boolean"/>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name="EngineeringNote" type="xs:string"/>
      <xs:element name="MemoryIndexSequence">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="MemoryIndex" minOccurs="0" maxOccurs="unbounded" type="xs:unsignedByte"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="Nickname" type="xs:string"/>
      <xs:element name="ParameterGroupSequence" type="ns0:ParameterGroupSequenceType"/>
      <xs:element name="Persistent" type="xs:boolean"/>
      <xs:element name="RefreshType">
        <xs:simpleType>
          <xs:restriction base="xs:token">
            <xs:enumeration value="None">
              <xs:annotation>
                <xs:documentation>Context needs no refresh and has no refresh mechanism</xs:documentation>
              </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Demand">
              <xs:annotation>
                <xs:documentation>Context is refreshed on demand via the LPI refresh command</xs:documentation>
              </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Auto">
              <xs:annotation>
                <xs:documentation>Context is automatically refreshed on access</xs:documentation>
              </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Reinit">
              <xs:annotation>
                <xs:documentation>Context can only be refreshed by reinitializing the device or rebooting</xs:documentation>
              </xs:annotation>
            </xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:all>
    <xs:attributeGroup ref="ns0:name_id_index"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="ParameterGroupSequenceType">
    <xs:sequence>
      <xs:element name="ParameterGroupReference" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:all>
            <xs:element name="Cacheable" maxOccurs="1" type="xs:boolean"/>
            <xs:element name="ParameterGroupName" maxOccurs="1" type="xs:string"/>
          </xs:all>
          <xs:attributeGroup ref="ns0:index"/>
          <xs:attributeGroup ref="ns0:node-id"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ParameterGroupType">
    <xs:sequence>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name="Direction">
        <xs:simpleType>
          <xs:restriction base="xs:token">
            <xs:enumeration value="Input">
              <xs:annotation>
                <xs:documentation>Parameters in the group are modifiable by SW and not modifiable by FW</xs:documentation>
              </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Output">
              <xs:annotation>
                <xs:documentation>Parameters in the group are modifiable by FW and not modifiable by SW</xs:documentation>
              </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Bidirectional">
              <xs:annotation>
                <xs:documentation>Parameters in the group are modifiable by SW or FW</xs:documentation>
              </xs:annotation>
            </xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="EngineeringNote" type="xs:string"/>
      <xs:element name="Parameter" minOccurs="0" maxOccurs="unbounded" type="ns0:ParameterType"/>
    </xs:sequence>
    <xs:attributeGroup ref="ns0:name_id"/>
    <xs:attributeGroup ref="ns0:version_revision"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="ParameterType">
    <xs:all>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name="EngineeringNote" type="xs:string"/>
      <xs:element name="ElementCount" type="xs:unsignedInt"/>
      <xs:element name="Nickname" type="xs:string"/>
      <xs:element name="DataType" type="ns0:DataTypeType"/>
    </xs:all>
    <xs:attributeGroup ref="ns0:name_id_index"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="DataTypeType">
    <xs:choice minOccurs="1">
      <xs:element name="Boolean" />
      <xs:element name="Utf8" />
      <xs:element name="FixedPoint">
        <xs:complexType>
          <xs:all>
            <xs:element name="SignBitCount" type="xs:unsignedByte"/>
            <xs:element name="IntegerBitCount" type="xs:unsignedByte"/>
            <xs:element name="FractionalBitCount" type="xs:unsignedByte"/>
            <xs:element name="NormalizedMax" type="xs:long"/>
            <xs:element name="NormalizedMin" type="xs:long"/>
            <xs:element name="Units" type="ns0:UnitsType"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="Integer">
        <xs:complexType>
          <xs:all>
            <xs:element name="SignBitCount" type="xs:unsignedByte"/>
            <xs:element name="IntegerBitCount" type="xs:unsignedByte"/>
            <xs:element name="NormalizedMax" type="xs:long"/>
            <xs:element name="NormalizedMin" type="xs:long"/>
            <xs:element name="Units" type="ns0:UnitsType"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="Byte" />
      <xs:element name="EnumerationReference">
        <xs:complexType>
          <xs:all>
            <xs:element name="DefinitionName" type="xs:string"/>
            <xs:element name="EnumerationName" type="xs:string"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="DateTime" />
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="EnumerationDefinitionType">
    <xs:sequence>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name="Enumeration" minOccurs="1" maxOccurs="unbounded" type="ns0:EnumerationType"/>
      <xs:element name="ItemDefinition" minOccurs="0" maxOccurs="unbounded" type="ns0:ItemDefinitionType"/>
    </xs:sequence>
    <xs:attributeGroup ref="ns0:name_id"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="ItemDefinitionType">
    <xs:all>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name="Nickname" type="xs:string"/>
    </xs:all>
    <xs:attributeGroup ref="ns0:name_id"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="EnumerationType">
    <xs:sequence>
      <xs:element name="BitCount" type="xs:int"/>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name="Item" minOccurs="0" maxOccurs="unbounded" type="ns0:ReferenceType"/>
    </xs:sequence>
    <xs:attributeGroup ref="ns0:name_id"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="ReferenceType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attributeGroup ref="ns0:index"/>
        <xs:attributeGroup ref="ns0:node-id"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="UnitsType">
      <xs:choice>
        <xs:element name="None" type="ns0:UnitTypeNone"/>
        <xs:element name="Ratio" type="ns0:UnitTypeRatio"/>
        <xs:element name="Storage" type="ns0:UnitTypeStorage"/>
        <xs:element name="Time" type="ns0:UnitTypeTime"/>
        <xs:element name="Power" type="ns0:UnitTypePower"/>
        <xs:element name="Voltage" type="ns0:UnitTypeVoltage"/>
        <xs:element name="Current" type="ns0:UnitTypeCurrent"/>
        <xs:element name="Frequency" type="ns0:UnitTypeFrequency"/>
        <xs:element name="Distance" type="ns0:UnitTypeDistance"/>
        <xs:element name="Acceleration" type="ns0:UnitTypeAcceleration"/>
        <xs:element name="Phase" type="ns0:UnitTypePhase"/>
        <xs:element name="AngularVelocity" type="ns0:UnitTypeAngularVelocity"/>
        <xs:element name="LinearVelocity" type="ns0:UnitTypeLinearVelocity"/>
        <xs:element name="Temperature" type="ns0:UnitTypeTemperature"/>
        <xs:element name="Slope" type="ns0:UnitTypeSlope"/>
        <xs:element name="DataRate" type="ns0:UnitTypeDataRate"/>
        <xs:element name="Energy" type="ns0:UnitTypeEnergy"/>
      </xs:choice>
  </xs:complexType>
  <xs:simpleType name="UnitTypeNone">
    <xs:restriction base="xs:token">
      <xs:enumeration value="none">
        <xs:annotation>
          <xs:documentation>Dimensionless quantity</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeRatio">
    <xs:restriction base="xs:token">
      <xs:enumeration value="%">
        <xs:annotation>
          <xs:documentation>Percent</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="dB">
        <xs:annotation>
          <xs:documentation>Gain (in dB)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="-dBFS">
        <xs:annotation>
          <xs:documentation>Level relative to full scale (in dB)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="-log2">
        <xs:annotation>
          <xs:documentation>-log2(coefficent)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeStorage">
    <xs:restriction base="xs:token">
      <xs:enumeration value="B">
        <xs:annotation>
          <xs:documentation>Bytes</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="KB">
        <xs:annotation>
          <xs:documentation>Kilobytes</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MB">
        <xs:annotation>
          <xs:documentation>Megabytes</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeTime">
    <xs:restriction base="xs:token">
      <xs:enumeration value="us">
        <xs:annotation>
          <xs:appinfo>alternate</xs:appinfo>
          <xs:documentation>Microseconds</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="μs">
        <xs:annotation>
          <xs:documentation>Microseconds</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ms">
        <xs:annotation>
          <xs:documentation>Milliseconds</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="s">
        <xs:annotation>
          <xs:documentation>Seconds</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="min">
        <xs:annotation>
          <xs:documentation>Minutes</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="h">
        <xs:annotation>
          <xs:documentation>Hours</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="d">
        <xs:annotation>
          <xs:documentation>Days</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="log2TC">
        <xs:annotation>
          <xs:documentation>Log2(Time Constant)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypePower">
    <xs:restriction base="xs:token">
      <xs:enumeration value="mW">
        <xs:annotation>
          <xs:documentation>Milliwatts</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="W">
        <xs:annotation>
          <xs:documentation>Watts</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="dBm">
        <xs:annotation>
          <xs:documentation>Power level relative to 1mW</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeVoltage">
    <xs:restriction base="xs:token">
      <xs:enumeration value="mV">
        <xs:annotation>
          <xs:documentation>Millivolts</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="V">
        <xs:annotation>
          <xs:documentation>Volts</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="dBuV">
        <xs:annotation>
          <xs:appinfo>alternate</xs:appinfo>
          <xs:documentation>Volts relative to 1μV</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="dBμV">
        <xs:annotation>
          <xs:documentation>Volts relative to 1μV</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeCurrent">
    <xs:restriction base="xs:token">
      <xs:enumeration value="mA">
        <xs:annotation>
          <xs:documentation>Milliamps</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeFrequency">
    <xs:restriction base="xs:token">
      <xs:enumeration value="Hz">
        <xs:annotation>
          <xs:documentation>Hertz</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="kHz">
        <xs:annotation>
          <xs:documentation>Kilohertz</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeDistance">
    <xs:restriction base="xs:token">
      <xs:enumeration value="mm">
        <xs:annotation>
          <xs:documentation>Millimeters</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="m">
        <xs:annotation>
          <xs:documentation>Meters</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="km">
        <xs:annotation>
          <xs:documentation>Kilometers</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeAcceleration">
    <xs:restriction base="xs:token">
      <xs:enumeration value="g">
        <xs:annotation>
          <xs:documentation>Gravity of Earth</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypePhase">
    <xs:restriction base="xs:token">
      <xs:enumeration value="degrees">
        <xs:annotation>
          <xs:appinfo>alternate</xs:appinfo>
          <xs:documentation>Phase Angle</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="°">
        <xs:annotation>
          <xs:documentation>Phase Angle</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeAngularVelocity">
    <xs:restriction base="xs:token">
      <xs:enumeration value="Hz">
        <xs:annotation>
          <xs:documentation>Angular Velocity</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeLinearVelocity">
    <xs:restriction base="xs:token">
      <xs:enumeration value="m/s">
        <xs:annotation>
          <xs:documentation>Linear Velocity</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeTemperature">
    <xs:restriction base="xs:token">
      <xs:enumeration value="C">
        <xs:annotation>
          <xs:appinfo>alternate</xs:appinfo>
          <xs:documentation>Centigrade</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="°C">
        <xs:annotation>
          <xs:documentation>Centigrade</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="F">
        <xs:annotation>
          <xs:appinfo>alternate</xs:appinfo>
          <xs:documentation>Fahrenheit</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="°F">
        <xs:annotation>
          <xs:documentation>Fahrenheit</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeSlope">
    <xs:restriction base="xs:token">
      <xs:enumeration value="dB/log10(Hz)">
        <xs:annotation>
          <xs:documentation>Gain vs. log10(frequency)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeDataRate">
    <xs:restriction base="xs:token">
      <xs:enumeration value="Mbps">
        <xs:annotation>
          <xs:documentation>Megabits per second</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Kbps">
        <xs:annotation>
          <xs:documentation>Kilobits per second</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Baud">
        <xs:annotation>
          <xs:documentation>Baud rate</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeEnergy">
    <xs:restriction base="xs:token">
      <xs:enumeration value="J">
        <xs:annotation>
          <xs:documentation>Joules</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Cal">
        <xs:annotation>
          <xs:documentation>Calories</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="kcal">
        <xs:annotation>
          <xs:documentation>Kilocalories</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="V²/s">
        <xs:annotation>
          <xs:documentation>Signal energy in volts squared per second</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  
  <xs:attributeGroup name="id">
    <xs:attribute name="id" type="xs:int" use="required">
      <xs:annotation>
        <xs:documentation>A unique number that is used by firmware to refer to the entity</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="name">
    <xs:attribute name="name" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>A unique name that can be used by software to refer to the entity</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="index">
    <xs:attribute name="index" type="xs:unsignedByte" use="required">
      <xs:annotation>
        <xs:documentation>A unique number that is used to order entities</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="name_id">
    <xs:attributeGroup ref="ns0:id"/>
    <xs:attributeGroup ref="ns0:name"/>
  </xs:attributeGroup>
  <xs:attributeGroup name="name_id_index">
    <xs:attributeGroup ref="ns0:name_id"/>
    <xs:attributeGroup ref="ns0:index"/>
  </xs:attributeGroup>
  <xs:attributeGroup name="version_revision_identifier">
    <xs:attribute name="major" type="xs:integer" use="required">
      <xs:annotation>
        <xs:documentation>The major version number increments with a breaking change</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="minor" type="xs:integer" use="required">
      <xs:annotation>
        <xs:documentation>The minor version number increments with non-breaking changes</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="identifier" type="xs:integer" use="required">
      <xs:annotation>
        <xs:documentation>The identifier number is a unique 16-bit value for non-T3 releases and zero for all T3 releases</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="version_revision">
    <xs:attribute name="major" type="xs:integer" use="required">
      <xs:annotation>
        <xs:documentation>The major version number increments with a breaking change</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="minor" type="xs:integer" use="required">
      <xs:annotation>
        <xs:documentation>The minor version number increments with non-breaking changes</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="node-id">
    <xs:attribute name="source-nodeId" type="xs:unsignedInt" use="optional">
      <xs:annotation>
        <xs:documentation>An unique identifier that uniquely identifies an entity within the session</xs:documentation>
      </xs:annotation>
    </xs:attribute>

  </xs:attributeGroup>
</xs:schema>