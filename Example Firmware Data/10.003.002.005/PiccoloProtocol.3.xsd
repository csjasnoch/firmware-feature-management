<?xml version="1.0" encoding="utf-8"?>

<!--Schema for validating PiccoloProtocol.xml-->

<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ns0="Starkey.FWE.PiccoloProtocol.3"
           targetNamespace="Starkey.FWE.PiccoloProtocol.3">

  <xs:element name="Protocol">
    <xs:complexType>
      <xs:all>
        <xs:element name="Primary" type="ns0:PrimaryType"/>
      </xs:all>
      <xs:attributeGroup ref="ns0:node-id"/>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="PrimaryType">
    <xs:all>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name="Branch" type="ns0:BranchType"/>
    </xs:all>
    <xs:attributeGroup ref="ns0:name_id"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="BranchType">
    <xs:all>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name ="ProtocolVersion" type="ns0:ProtocolVersionType" maxOccurs="1">
      </xs:element>
    </xs:all>
    <xs:attributeGroup ref="ns0:name_id"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="ProtocolVersionType">
    <xs:all>
      <xs:element name="MessageExchangeCollection">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="MessageExchange" minOccurs="0" maxOccurs="unbounded" type="ns0:MessageExchangeType"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="FieldCollection">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Field" minOccurs="0" maxOccurs="unbounded" type="ns0:FieldType"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="EnumerationDefinitionCollection">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="EnumerationDefinition" minOccurs="0" maxOccurs="unbounded" type="ns0:EnumerationDefinitionType"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:all>
    <xs:attributeGroup ref="ns0:version_revision_identifier"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="MessageExchangeType">
    <xs:all>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name="EngineeringNote" minOccurs="0" type="xs:string"/>
      <xs:element name="Nickname" type="xs:string"/>
      <xs:element name="RevisionSequence" type="ns0:RevisionSequenceType"/>
      <xs:element name="ServiceId" type="xs:unsignedInt"/>
      <xs:element name="Parent" minOccurs="0" type="xs:string"/>
    </xs:all>
    <xs:attributeGroup ref="ns0:name_id"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="RevisionSequenceType">
    <xs:sequence>
      <xs:element name="Revision" minOccurs="0" maxOccurs="unbounded" type="ns0:RevisionType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="CapabilityCommandType">
    <xs:attributeGroup ref="ns0:bit_byte_name"/>
  </xs:complexType>
  <xs:complexType name="FieldSequenceType">
    <xs:sequence>
      <xs:element name="FieldReference" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:all>
            <xs:element name="FieldName" type="xs:string"/>
            <xs:element name="ArgName" type="xs:string"/>
            <xs:element name="RequiredArg" minOccurs="0" type="xs:boolean"/>
          </xs:all>
          <xs:attributeGroup ref="ns0:bit_byte"/>
          <xs:attributeGroup ref="ns0:node-id"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attributeGroup ref="ns0:name_id"/>
    <xs:attributeGroup ref="ns0:min_max"/>
  </xs:complexType>
  <xs:complexType name="RevisionType">
    <xs:sequence>
      <xs:element name="Nickname" type="xs:string"/>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name="EngineeringNote" minOccurs="0" type="xs:string"/>
      <xs:element name="CapabilityCommand" minOccurs="0" type="ns0:CapabilityCommandType"/>
      <xs:element name="Status" minOccurs="0" type="ns0:StatusType"/>
      <xs:element name="ProgrammingMode" minOccurs="0" type="xs:boolean"/>
      <xs:element name="FactoryMode" minOccurs="0" type="xs:boolean"/>
      <xs:element name="RequestFieldSequence" minOccurs="0" maxOccurs="unbounded" type="ns0:FieldSequenceType"/>
      <xs:element name="ResponseFieldSequence" minOccurs="0" maxOccurs="unbounded" type="ns0:FieldSequenceType"/>
    </xs:sequence>
    <xs:attributeGroup ref="ns0:name_id"/>
    <xs:attributeGroup ref="ns0:version_revision"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="FieldType">
    <xs:all>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name="EngineeringNote" minOccurs="0" type="xs:string"/>
      <xs:element name="Constant" minOccurs="0" type="xs:boolean"/>
      <xs:element name="LengthField" minOccurs="0" type="xs:boolean"/>
      <xs:element name="Subfield" minOccurs="0" type="xs:boolean"/>
      <xs:element name="ParentField" minOccurs="0" type="xs:boolean"/>
      <xs:element name="Nickname" type="xs:string"/>
      <xs:element name="DataType" type="ns0:DataTypeType"/>
      <xs:element name="ElementCount" type="xs:unsignedInt"/>
      <xs:element name="Frame" minOccurs="0" type="xs:boolean"/>
      <xs:element name="FrameCount" minOccurs="0" type="xs:unsignedInt"/>
      <xs:element name="Nullable" minOccurs="0" type="xs:boolean"/>
    </xs:all>
    <xs:attributeGroup ref="ns0:name_id"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="DataTypeType">
    <xs:choice minOccurs="1">
      <xs:element name="Boolean">
        <xs:complexType>
          <xs:all>
            <xs:element name="Default" type="xs:boolean"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="Utf8" />
      <xs:element name="FixedPoint">
        <xs:complexType>
          <xs:all>
            <xs:element name="SignBitCount" type="xs:unsignedByte"/>
            <xs:element name="IntegerBitCount" type="xs:unsignedByte"/>
            <xs:element name="FractionalBitCount" type="xs:unsignedByte"/>
            <xs:element name="NormalizedMax" type="xs:long"/>
            <xs:element name="NormalizedMin" type="xs:long"/>
            <xs:element name="NormalizedDefault" type="xs:long"/>
            <xs:element name="Units" type="ns0:UnitsType"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="Integer">
        <xs:complexType>
          <xs:all>
            <xs:element name="SignBitCount" type="xs:unsignedByte"/>
            <xs:element name="IntegerBitCount" type="xs:unsignedByte"/>
            <xs:element name="Max" type="xs:long"/>
            <xs:element name="Min" type="xs:long"/>
            <xs:element name="Default" type="xs:long"/>
            <xs:element name="Units" type="ns0:UnitsType"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="Byte" />
      <xs:element name="EnumerationReference">
        <xs:complexType>
          <xs:all>
            <xs:element name="DefinitionName" type="xs:string"/>
            <xs:element name="EnumerationName" type="xs:string"/>
            <xs:element name="BitCount" type="xs:unsignedByte"/>
            <xs:element name="Default" type="xs:string"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="DateTime" />
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="EnumerationDefinitionType">
    <xs:sequence>
      <xs:element name="Nickname" type="xs:string"/>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name="Enumeration" maxOccurs="unbounded" type="ns0:EnumerationType"/>
      <xs:element name="ItemDefinition" minOccurs="0" maxOccurs="unbounded" type="ns0:ItemDefinitionType"/>
    </xs:sequence>
    <xs:attributeGroup ref="ns0:name_id"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="ItemDefinitionType">
    <xs:all>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name="EngineeringNote" minOccurs="0" type="xs:string"/>
      <xs:element name="CapabilityCommand" minOccurs="0" type="ns0:CapabilityCommandType"/>
      <xs:element name="Nickname" type="xs:string"/>
      <xs:element name="Status" minOccurs="0" type="ns0:StatusType"/>
    </xs:all>
    <xs:attributeGroup ref="ns0:name_id"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="EnumerationType">
    <xs:sequence>
      <xs:element name="Nickname" type="xs:string"/>
      <xs:element name="Description" type="xs:string"/>
      <xs:element name="Item" minOccurs="0" maxOccurs="unbounded" type="ns0:ReferenceType"/>
    </xs:sequence>
    <xs:attributeGroup ref="ns0:name_id"/>
    <xs:attributeGroup ref="ns0:node-id"/>
  </xs:complexType>
  <xs:complexType name="ReferenceType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attributeGroup ref="ns0:node-id"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="UnitsType">
      <xs:choice>
        <xs:element name="None" type="ns0:UnitTypeNone"/>
        <xs:element name="Ratio" type="ns0:UnitTypeRatio"/>
        <xs:element name="Storage" type="ns0:UnitTypeStorage"/>
        <xs:element name="Time" type="ns0:UnitTypeTime"/>
        <xs:element name="Power" type="ns0:UnitTypePower"/>
        <xs:element name="Voltage" type="ns0:UnitTypeVoltage"/>
        <xs:element name="Current" type="ns0:UnitTypeCurrent"/>
        <xs:element name="Frequency" type="ns0:UnitTypeFrequency"/>
        <xs:element name="Distance" type="ns0:UnitTypeDistance"/>
        <xs:element name="Acceleration" type="ns0:UnitTypeAcceleration"/>
        <xs:element name="Phase" type="ns0:UnitTypePhase"/>
        <xs:element name="AngularVelocity" type="ns0:UnitTypeAngularVelocity"/>
        <xs:element name="LinearVelocity" type="ns0:UnitTypeLinearVelocity"/>
        <xs:element name="Temperature" type="ns0:UnitTypeTemperature"/>
        <xs:element name="Slope" type="ns0:UnitTypeSlope"/>
        <xs:element name="DataRate" type="ns0:UnitTypeDataRate"/>
        <xs:element name="Energy" type="ns0:UnitTypeEnergy"/>
      </xs:choice>
  </xs:complexType>
  <xs:simpleType name="UnitTypeNone">
    <xs:restriction base="xs:token">
      <xs:enumeration value="none">
        <xs:annotation>
          <xs:documentation>Dimensionless quantity</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeRatio">
    <xs:restriction base="xs:token">
      <xs:enumeration value="%">
        <xs:annotation>
          <xs:documentation>Percent</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="dB">
        <xs:annotation>
          <xs:documentation>Gain (in dB)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="-dBFS">
        <xs:annotation>
          <xs:documentation>Level relative to full scale (in dB)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="-log2">
        <xs:annotation>
          <xs:documentation>-log2(coefficent)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeStorage">
    <xs:restriction base="xs:token">
      <xs:enumeration value="B">
        <xs:annotation>
          <xs:documentation>Bytes</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="KB">
        <xs:annotation>
          <xs:documentation>Kilobytes</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MB">
        <xs:annotation>
          <xs:documentation>Megabytes</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeTime">
    <xs:restriction base="xs:token">
      <xs:enumeration value="us">
        <xs:annotation>
          <xs:appinfo>alternate</xs:appinfo>
          <xs:documentation>Microseconds</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="μs">
        <xs:annotation>
          <xs:documentation>Microseconds</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ms">
        <xs:annotation>
          <xs:documentation>Milliseconds</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="s">
        <xs:annotation>
          <xs:documentation>Seconds</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="min">
        <xs:annotation>
          <xs:documentation>Minutes</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="h">
        <xs:annotation>
          <xs:documentation>Hours</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="d">
        <xs:annotation>
          <xs:documentation>Days</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="log2TC">
        <xs:annotation>
          <xs:documentation>Log2(Time Constant)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypePower">
    <xs:restriction base="xs:token">
      <xs:enumeration value="mW">
        <xs:annotation>
          <xs:documentation>Milliwatts</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="W">
        <xs:annotation>
          <xs:documentation>Watts</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="dBm">
        <xs:annotation>
          <xs:documentation>Power level relative to 1mW</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeVoltage">
    <xs:restriction base="xs:token">
      <xs:enumeration value="mV">
        <xs:annotation>
          <xs:documentation>Millivolts</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="V">
        <xs:annotation>
          <xs:documentation>Volts</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="dBuV">
        <xs:annotation>
          <xs:appinfo>alternate</xs:appinfo>
          <xs:documentation>Volts relative to 1μV</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="dBμV">
        <xs:annotation>
          <xs:documentation>Volts relative to 1μV</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeCurrent">
    <xs:restriction base="xs:token">
      <xs:enumeration value="mA">
        <xs:annotation>
          <xs:documentation>Milliamps</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeFrequency">
    <xs:restriction base="xs:token">
      <xs:enumeration value="Hz">
        <xs:annotation>
          <xs:documentation>Hertz</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="kHz">
        <xs:annotation>
          <xs:documentation>Kilohertz</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="bpm">
        <xs:annotation>
          <xs:documentation>Breaths (or beats) per minute</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeDistance">
    <xs:restriction base="xs:token">
      <xs:enumeration value="mm">
        <xs:annotation>
          <xs:documentation>Millimeters</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="m">
        <xs:annotation>
          <xs:documentation>Meters</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="km">
        <xs:annotation>
          <xs:documentation>Kilometers</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeAcceleration">
    <xs:restriction base="xs:token">
      <xs:enumeration value="g">
        <xs:annotation>
          <xs:documentation>Gravity of Earth</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypePhase">
    <xs:restriction base="xs:token">
      <xs:enumeration value="degrees">
        <xs:annotation>
          <xs:appinfo>alternate</xs:appinfo>
          <xs:documentation>Phase angle</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="°">
        <xs:annotation>
          <xs:documentation>Phase angle</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeAngularVelocity">
    <xs:restriction base="xs:token">
      <xs:enumeration value="Hz">
        <xs:annotation>
          <xs:documentation>Angular velocity as a frequency in Hertz</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="dps">
        <xs:annotation>
          <xs:documentation>Degrees per second</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeLinearVelocity">
    <xs:restriction base="xs:token">
      <xs:enumeration value="m/s">
        <xs:annotation>
          <xs:documentation>Metres per second</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeTemperature">
    <xs:restriction base="xs:token">
      <xs:enumeration value="C">
        <xs:annotation>
          <xs:appinfo>alternate</xs:appinfo>
          <xs:documentation>Centigrade</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="°C">
        <xs:annotation>
          <xs:documentation>Centigrade</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="F">
        <xs:annotation>
          <xs:appinfo>alternate</xs:appinfo>
          <xs:documentation>Fahrenheit</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="°F">
        <xs:annotation>
          <xs:documentation>Fahrenheit</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeSlope">
    <xs:restriction base="xs:token">
      <xs:enumeration value="dB/log10(Hz)">
        <xs:annotation>
          <xs:documentation>Gain vs. log10(frequency)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeDataRate">
    <xs:restriction base="xs:token">
      <xs:enumeration value="Mbps">
        <xs:annotation>
          <xs:documentation>Megabits per second</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Kbps">
        <xs:annotation>
          <xs:documentation>Kilobits per second</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Baud">
        <xs:annotation>
          <xs:documentation>Baud rate</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnitTypeEnergy">
    <xs:restriction base="xs:token">
      <xs:enumeration value="J">
        <xs:annotation>
          <xs:documentation>Joules</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Cal">
        <xs:annotation>
          <xs:documentation>Calories</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="kcal">
        <xs:annotation>
          <xs:documentation>Kilocalories</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="V²/s">
        <xs:annotation>
          <xs:documentation>Signal energy in volts squared per second</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="StatusType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="Deprecated">
        <xs:annotation>
          <xs:documentation>Entity is deprecated (will no longer be supported in a future release)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DevelopmentBuild">
        <xs:annotation>
          <xs:documentation>Entity is only supported in development builds</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Obsolete">
        <xs:annotation>
          <xs:documentation>Entity is no longer supported</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Supported">
        <xs:annotation>
          <xs:documentation>Entity is supported</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:attributeGroup name="id">
    <xs:attribute name="id" type="xs:int" use="required">
      <xs:annotation>
        <xs:documentation>A unique number that is used by firmware to refer to the entity</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="name">
    <xs:attribute name="name" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>A unique name that can be used by software to refer to the entity</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="min">
    <xs:attribute name="min" type="xs:integer" use="required">
      <xs:annotation>
        <xs:documentation>Minimum number of bytes</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="max">
    <xs:attribute name="max" type="xs:integer" use="required">
      <xs:annotation>
        <xs:documentation>Maximum number of bytes</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="bit">
    <xs:attribute name="bit" type="xs:integer" use="required">
      <xs:annotation>
        <xs:documentation>Bit position</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="byte">
    <xs:attribute name="byte" type="xs:integer" use="required">
      <xs:annotation>
        <xs:documentation>Byte position</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="name_id">
    <xs:attributeGroup ref="ns0:id"/>
    <xs:attributeGroup ref="ns0:name"/>
  </xs:attributeGroup>
  <xs:attributeGroup name="min_max">
    <xs:attributeGroup ref="ns0:min"/>
    <xs:attributeGroup ref="ns0:max"/>
  </xs:attributeGroup>
  <xs:attributeGroup name="bit_byte">
    <xs:attributeGroup ref="ns0:bit"/>
    <xs:attributeGroup ref="ns0:byte"/>
  </xs:attributeGroup>
  <xs:attributeGroup name="bit_byte_name">
    <xs:attributeGroup ref="ns0:bit"/>
    <xs:attributeGroup ref="ns0:byte"/>
    <xs:attributeGroup ref="ns0:name"/>
  </xs:attributeGroup>
  <xs:attributeGroup name="version_revision_identifier">
    <xs:attribute name="major" type="xs:integer" use="required">
      <xs:annotation>
        <xs:documentation>The major version number increments with a breaking change</xs:documentation>
      </xs:annotation>
