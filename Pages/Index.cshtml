@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="display-5">Firmware Feature Management</h1>
            <p class="text-muted">Multi-collection workspace for cross-program feature engineering</p>
        </div>
        <div>
            <span class="badge bg-secondary">@Model.CurrentContext.NpiProgramName</span>
            <span class="badge bg-info">LPI @Model.CurrentContext.LpiVersionNumber</span>
            <span class="badge bg-info">PICCOLO @Model.CurrentContext.PiccoloVersionNumber</span>
            <button class="btn btn-sm btn-outline-primary ms-2" data-bs-toggle="modal" data-bs-target="#contextModal">
                <i class="bi bi-gear"></i> Change Context
            </button>
        </div>
    </div>
</div>

<!-- Quick Stats Row -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-start border-primary border-4 h-100">
            <div class="card-body">
                <h6 class="text-muted text-uppercase mb-1">Total Features</h6>
                <h2 class="mb-0">@Model.TotalFeatures</h2>
                <small class="text-muted">Across all collections</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-start border-success border-4 h-100">
            <div class="card-body">
                <h6 class="text-muted text-uppercase mb-1">Total Collections</h6>
                <h2 class="mb-0">@Model.TotalCollections</h2>
                <small class="text-success">@Model.CompatibleCollectionsCount compatible with current context</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-start border-info border-4 h-100">
            <div class="card-body">
                <h6 class="text-muted text-uppercase mb-1">NPI Programs</h6>
                <h2 class="mb-0">@Model.TotalNpiPrograms</h2>
                <small class="text-muted">Edina, Eagan, Fridley, etc.</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-start border-warning border-4 h-100">
            <div class="card-body">
                <h6 class="text-muted text-uppercase mb-1">Reused Features</h6>
                <h2 class="mb-0">@Model.FeatureReuseStats.Count</h2>
                <small class="text-muted">Features in multiple collections</small>
            </div>
        </div>
    </div>
</div>

<!-- Active Collections Workspace -->
<div class="row mb-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-briefcase"></i> Active Collections Workspace</h5>
                    <a href="/Collections/Create" class="btn btn-sm btn-light">
                        <i class="bi bi-plus-circle"></i> New Collection
                    </a>
                </div>
            </div>
            <div class="card-body">
                @if (Model.ActiveCollections.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Collection</th>
                                    <th>Program</th>
                                    <th>Features</th>
                                    <th>Compatibility</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var collection in Model.ActiveCollections)
                                {
                                    var npiProgram = Model.NpiPrograms.FirstOrDefault(p => p.Id == collection.NpiProgramId);
                                    var lpiVersion = Model.LpiVersions.FirstOrDefault(v => v.Id == collection.RequiredLpiVersionId);
                                    var piccoloVersion = Model.PiccoloVersions.FirstOrDefault(v => v.Id == collection.RequiredPiccoloVersionId);

                                    <tr>
                                        <td>
                                            <strong>@collection.Name</strong>
                                            <br />
                                            <small class="text-muted">@collection.Description</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@npiProgram?.Name</span>
                                            <br />
                                            <small class="text-muted">
                                                LPI @lpiVersion?.Version<br />
                                                PICCOLO @piccoloVersion?.Version
                                            </small>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">@collection.Features.Count features</span>
                                        </td>
                                        <td>
                                            @Html.Raw(Model.GetCompatibilityBadge(collection))
                                        </td>
                                        <td>
                                            <a href="/Collections/Details?id=@collection.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i> Open
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                        <p class="mt-2">No active collections. <a href="/Collections/Create">Create one</a> to get started.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Collections Panel -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Recent Collections</h5>
            </div>
            <div class="card-body">
                @if (Model.RecentCollections.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var collection in Model.RecentCollections)
                        {
                            var npiProgram = Model.NpiPrograms.FirstOrDefault(p => p.Id == collection.NpiProgramId);
                            <a href="/Collections/Details?id=@collection.Id" class="list-group-item list-group-item-action">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <strong>@collection.Name</strong>
                                        <br />
                                        <small class="text-muted">
                                            <span class="badge bg-secondary">@npiProgram?.Name</span>
                                            @collection.Features.Count features
                                        </small>
                                    </div>
                                    <small class="text-muted">@collection.ModifiedAt.ToString("MM/dd")</small>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-center">No recent collections</p>
                }
                <div class="mt-3 text-center">
                    <a href="/Collections" class="btn btn-sm btn-outline-secondary">View All Collections</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cross-Collection Insights Row -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-diagram-3"></i> Feature Reuse Across Collections</h5>
            </div>
            <div class="card-body">
                @if (Model.FeatureReuseStats.Any())
                {
                    <p class="text-muted mb-3">Features appearing in multiple collections (enables feature pulling)</p>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Feature Name</th>
                                    <th>Collections Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var stat in Model.FeatureReuseStats)
                                {
                                    <tr>
                                        <td>@stat.Key</td>
                                        <td>
                                            <span class="badge bg-success">@stat.Value collections</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No features are reused across multiple collections yet.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-bar-chart"></i> Version Distribution</h5>
            </div>
            <div class="card-body">
                @if (Model.VersionDistribution.Any())
                {
                    <p class="text-muted mb-3">Collection distribution across firmware versions</p>
                    @foreach (var dist in Model.VersionDistribution)
                    {
                        var percentage = (dist.Value * 100.0 / Model.TotalCollections);
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <small class="fw-bold">@dist.Key</small>
                                <small class="text-muted">@dist.Value collections (@percentage.ToString("F0")%)</small>
                            </div>
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar bg-info" role="progressbar" style="width: @percentage%" 
                                     aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100">
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No version distribution data available.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <h5 class="mb-4">
                    <i class="bi bi-lightning-charge-fill text-primary"></i>
                    Quick Actions
                    <small class="text-muted fs-6">Common daily tasks</small>
                </h5>
                <div class="row g-3">
                    <!-- 1. Pull Feature from Collection -->
                    <div class="col-md-4">
                        <a href="/Collections/PullFeature" 
                           class="btn btn-outline-primary w-100 p-3"
                           data-chat-prompt="Help me find and pull features from other collections"
                           data-chat-context="PullFeature">
                            <i class="bi bi-arrow-left-right fs-3"></i>
                            <div class="mt-2">
                                <strong>Pull Feature</strong>
                                <small class="d-block text-muted">From another collection</small>
                            </div>
                        </a>
                    </div>

                    <!-- 2. Adapt Feature for Compatibility -->
                    <div class="col-md-4">
                        <a href="/Features/Compatibility" 
                           class="btn btn-outline-success w-100 p-3"
                           data-chat-prompt="Help me adapt a feature for compatibility with a different firmware version"
                           data-chat-context="FeatureCompatibility">
                            <i class="bi bi-wrench-adjustable fs-3"></i>
                            <div class="mt-2">
                                <strong>Adapt Feature</strong>
                                <small class="d-block text-muted">For compatibility</small>
                            </div>
                        </a>
                    </div>

                    <!-- 3. Quick Debug: Byte Packets -->
                    <div class="col-md-4">
                        <a href="/Features/BytePacket" 
                           class="btn btn-outline-danger w-100 p-3"
                           data-chat-prompt="Help me analyze byte packet differences"
                           data-chat-context="FeatureBytePacket">
                            <i class="bi bi-bug-fill fs-3"></i>
                            <div class="mt-2">
                                <strong>Debug Packets</strong>
                                <small class="d-block text-muted">Byte-level inspection</small>
                            </div>
                        </a>
                    </div>

                    <!-- 4. Create New Collection -->
                    <div class="col-md-4">
                        <a href="/Collections/Create" 
                           class="btn btn-outline-info w-100 p-3"
                           data-chat-prompt="Help me create a new collection for my project"
                           data-chat-context="CollectionCreate">
                            <i class="bi bi-plus-circle-fill fs-3"></i>
                            <div class="mt-2">
                                <strong>New Collection</strong>
                                <small class="d-block text-muted">Start a project</small>
                            </div>
                        </a>
                    </div>

                    <!-- 5. Compare Collections -->
                    <div class="col-md-4">
                        <a href="/Collections/Compare" 
                           class="btn btn-outline-warning w-100 p-3"
                           data-chat-prompt="Help me compare features across multiple collections"
                           data-chat-context="CollectionCompare">
                            <i class="bi bi-diagram-3-fill fs-3"></i>
                            <div class="mt-2">
                                <strong>Compare</strong>
                                <small class="d-block text-muted">Multi-collection analysis</small>
                            </div>
                        </a>
                    </div>

                    <!-- 6. Today's Work Summary -->
                    <div class="col-md-4">
                        <button type="button" 
                                class="btn btn-outline-secondary w-100 p-3"
                                id="todayWorkBtn"
                                data-chat-prompt="Show me what I was working on recently and help me continue"
                                data-chat-context="Dashboard">
                            <i class="bi bi-clipboard-check-fill fs-3"></i>
                            <div class="mt-2">
                                <strong>Today's Work</strong>
                                <small class="d-block text-muted">Recent activity</small>
                            </div>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Context Switcher Modal -->
<div class="modal fade" id="contextModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Change Firmware Context</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post">
                <div class="modal-body">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Changing context filters collections and features throughout the application.
                    </div>

                    @if (Model.ContextHistory.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Recent Contexts</label>
                            <div class="list-group">
                                @foreach (var context in Model.ContextHistory.Take(3))
                                {
                                    <button type="button" class="list-group-item list-group-item-action" 
                                            onclick="selectContext('@context.NpiProgramId', '@context.LpiVersionId', '@context.PiccoloVersionId')">
                                        <strong>@context.NpiProgramName</strong> - 
                                        LPI @context.LpiVersionNumber + PICCOLO @context.PiccoloVersionNumber
                                        <small class="text-muted ms-2">(@context.LastModified.ToString("MM/dd HH:mm"))</small>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <hr />

                    <div class="row">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">NPI Program</label>
                            <select class="form-select" id="modalNpiProgram" name="npiProgramId" required>
                                @foreach (var program in Model.NpiPrograms)
                                {
                                    <option value="@program.Id" selected="@(program.Id == Model.CurrentContext.NpiProgramId)">
                                        @program.Name (@program.HardwareGen)
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">LPI Version</label>
                            <select class="form-select" id="modalLpiVersion" name="lpiVersionId" required>
                                @foreach (var version in Model.LpiVersions)
                                {
                                    <option value="@version.Id" data-npi="@version.NpiProgramId" 
                                            selected="@(version.Id == Model.CurrentContext.LpiVersionId)">
                                        @version.Version - @Model.GetStageDisplayName(version.Stage)
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">PICCOLO Version</label>
                            <select class="form-select" id="modalPiccoloVersion" name="piccoloVersionId" required>
                                @foreach (var version in Model.PiccoloVersions)
                                {
                                    <option value="@version.Id" data-npi="@version.NpiProgramId" 
                                            selected="@(version.Id == Model.CurrentContext.PiccoloVersionId)">
                                        @version.Version - @Model.GetStageDisplayName(version.Stage)
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Apply Context</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* AI Chat Panel *@
@await Html.PartialAsync("_ChatPanel", Model.DashboardChatContext)

@section Scripts {
<script>
    // Filter versions by selected NPI program
    document.getElementById('modalNpiProgram')?.addEventListener('change', function() {
        const selectedNpiId = this.value;
        filterVersionSelect('modalLpiVersion', selectedNpiId);
        filterVersionSelect('modalPiccoloVersion', selectedNpiId);
    });

    function filterVersionSelect(selectId, npiId) {
        const select = document.getElementById(selectId);
        if (!select) return;

        Array.from(select.options).forEach(option => {
            const optionNpiId = option.getAttribute('data-npi');
            if (optionNpiId === npiId || optionNpiId === null) {
                option.style.display = '';
                if (!select.value && optionNpiId === npiId) {
                    select.value = option.value;
                }
            } else {
                option.style.display = 'none';
            }
        });
    }

    function selectContext(npiId, lpiId, piccoloId) {
        document.getElementById('modalNpiProgram').value = npiId;
        filterVersionSelect('modalLpiVersion', npiId);
        filterVersionSelect('modalPiccoloVersion', npiId);
        document.getElementById('modalLpiVersion').value = lpiId;
        document.getElementById('modalPiccoloVersion').value = piccoloId;
    }

    // Initialize version filters on modal show
    document.getElementById('contextModal')?.addEventListener('show.bs.modal', function() {
        const selectedNpiId = document.getElementById('modalNpiProgram').value;
        filterVersionSelect('modalLpiVersion', selectedNpiId);
        filterVersionSelect('modalPiccoloVersion', selectedNpiId);
    });

    // Handle "Today's Work" quick action - show chat with context
    document.getElementById('todayWorkBtn')?.addEventListener('click', function() {
        if (window.chatApp) {
            // Open chat panel if collapsed
            if (document.getElementById('chatPanel')?.classList.contains('collapsed')) {
                window.chatApp.togglePanel();
            }
            
            // Use the suggested prompt
            const prompt = this.getAttribute('data-chat-prompt');
            window.chatApp.useSuggestedPrompt(prompt);
        }
    });
</script>
}
