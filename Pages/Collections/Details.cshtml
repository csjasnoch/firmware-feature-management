@page
@model WebApp.Pages.Collections.DetailsModel
@{
    ViewData["Title"] = Model.Collection?.Name ?? "Collection Details";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/Collections">Collections</a></li>
                    <li class="breadcrumb-item active">@Model.Collection?.Name</li>
                </ol>
            </nav>
        </div>
    </div>

    @if (Model.Collection != null)
    {
        <div class="row mb-4">
            <div class="col">
                <h2>📦 @Model.Collection.Name</h2>
                <p class="text-muted">@Model.Collection.Description</p>
            </div>
            <div class="col-auto">
                @if (!Model.Collection.IsLocked)
                {
                    <a href="/Collections/Edit?id=@Model.Collection.Id" class="btn btn-primary">Edit Collection</a>
                }
                <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#featureBrowserModal">
                    <i class="bi bi-plus-circle"></i> Pull Feature from Other Collections
                </button>
                <a href="/Collections" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </div>

        <!-- NPI Program & Firmware Versions -->
        <div class="card mb-4">
            <div class="card-header">
                <strong>NPI Program & Firmware Versions</strong>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <strong>NPI Program:</strong> @Model.Collection.TargetProgram?.Name (v@Model.Collection.TargetProgram?.MajorVersion.x - @Model.Collection.TargetProgram?.Status)
                        <br/>
                        <small class="text-muted">@Model.Collection.TargetProgram?.Description</small>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <h6>LPI Version</h6>
                        <div>
                            <strong>@Model.Collection.RequiredLpiVersion?.Version</strong> 
                            <span class="badge bg-success">@Model.Collection.RequiredLpiVersion?.Stage</span>
                            @if (Model.Collection.RequiredLpiVersion?.Stage == FirmwareReleaseStage.T3_Released)
                            {
                                <span>📌 Locked</span>
                            }
                        </div>
                        <div class="small text-muted">
                            Released: @Model.Collection.RequiredLpiVersion?.ReleasedAt.ToString("yyyy-MM-dd")
                        </div>
                        <div class="small text-muted">
                            @Model.Collection.RequiredLpiVersion?.Parameters.Count parameters available
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h6>PICCOLO Version</h6>
                        <div>
                            <strong>@Model.Collection.RequiredPiccoloVersion?.Version</strong> 
                            <span class="badge bg-success">@Model.Collection.RequiredPiccoloVersion?.Stage</span>
                            @if (Model.Collection.RequiredPiccoloVersion?.Stage == FirmwareReleaseStage.T3_Released)
                            {
                                <span>📌 Locked</span>
                            }
                        </div>
                        <div class="small text-muted">
                            Released: @Model.Collection.RequiredPiccoloVersion?.ReleasedAt.ToString("yyyy-MM-dd")
                        </div>
                        <div class="small text-muted">
                            @Model.Collection.RequiredPiccoloVersion?.Commands.Count commands available
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Features -->
        <div class="card mb-4">
            <div class="card-header">
                <strong>Features (@Model.Collection.Features.Count)</strong>
            </div>
            <div class="card-body">
                @if (Model.Collection.Features.Any())
                {
                    <div class="list-group">
                        @foreach (var feature in Model.Collection.Features)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="mb-1">@feature.Name</h6>
                                        <p class="mb-1 small">@feature.Description</p>
                                        <div class="small text-muted">
                                            @if (feature.Parameters.Any())
                                            {
                                                <span class="badge bg-info">@feature.Parameters.Count parameters</span>
                                            }
                                            @if (feature.Commands.Any())
                                            {
                                                <span class="badge bg-secondary">@feature.Commands.Count commands</span>
                                            }
                                            <span>Modified: @feature.ModifiedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                        </div>
                                    </div>
                                    <div>
                                        <a href="/Features/Edit?id=@feature.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No features in this collection yet.</p>
                    <a href="/Features/Create?collectionId=@Model.Collection.Id" class="btn btn-primary">Add Feature</a>
                }
            </div>
        </div>

        <!-- Metadata -->
        <div class="card mb-4">
            <div class="card-header">
                <strong>Collection Metadata</strong>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Owner:</dt>
                            <dd class="col-sm-8">@Model.Collection.Owner</dd>
                            
                            <dt class="col-sm-4">Visibility:</dt>
                            <dd class="col-sm-8">
                                <span class="badge bg-primary">@Model.Collection.Visibility</span>
                            </dd>
                            
                            <dt class="col-sm-4">Created:</dt>
                            <dd class="col-sm-8">@Model.Collection.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                            
                            <dt class="col-sm-4">Modified:</dt>
                            <dd class="col-sm-8">@Model.Collection.ModifiedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Tags:</dt>
                            <dd class="col-sm-8">
                                @foreach (var tag in Model.Collection.Tags)
                                {
                                    <span class="badge bg-info">@tag</span>
                                }
                            </dd>
                            
                            <dt class="col-sm-4">Shared With:</dt>
                            <dd class="col-sm-8">
                                @if (Model.Collection.SharedWith.Any())
                                {
                                    @string.Join(", ", Model.Collection.SharedWith)
                                }
                                else
                                {
                                    <span class="text-muted">Not shared</span>
                                }
                            </dd>
                            
                            @if (Model.Collection.IsLocked)
                            {
                                <dt class="col-sm-4">Lock Status:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-warning">🔒 Locked</span>
                                    <div class="small">@Model.Collection.LockedReason</div>
                                </dd>
                            }
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="card">
            <div class="card-header">
                <strong>Actions</strong>
            </div>
            <div class="card-body">
                <button class="btn btn-outline-primary">Export Collection</button>
                <button class="btn btn-outline-secondary">Duplicate</button>
                <button class="btn btn-outline-info">Share</button>
                @if (Model.Collection.IsLocked)
                {
                    <button class="btn btn-outline-warning">Unlock</button>
                }
                else
                {
                    <button class="btn btn-outline-warning">Lock</button>
                }
            </div>
        </div>
    }
</div>

<!-- Cross-Collection Feature Browser Modal -->
<div class="modal fade" id="featureBrowserModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-search"></i> Browse Features from All Collections</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Pull features from any collection, regardless of compatibility. 
                    Incompatible features will show warnings and offer adaptation options.
                </div>

                <!-- Search and Filter -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <input type="text" class="form-control" id="featureSearchInput" placeholder="Search features by name...">
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="collectionFilter">
                            <option value="">All Collections</option>
                            @foreach (var collection in Model.AllCollections.Where(c => c.Id != Model.Collection!.Id))
                            {
                                <option value="@collection.Id">@collection.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="categoryFilter">
                            <option value="">All Categories</option>
                            <option value="Audio Processing">Audio Processing</option>
                            <option value="Connectivity">Connectivity</option>
                            <option value="Firmware Management">Firmware Management</option>
                            <option value="Health & Wellness">Health & Wellness</option>
                            <option value="User Interface">User Interface</option>
                        </select>
                    </div>
                </div>

                <!-- Feature List -->
                <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-hover">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Feature</th>
                                <th>Source Collection</th>
                                <th>Category</th>
                                <th>Compatibility</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="featureTableBody">
                            @foreach (var feature in Model.AllAvailableFeatures)
                            {
                                var sourceCollection = Model.AllCollections.FirstOrDefault(c => c.Features.Any(f => f.Id == feature.Id));
                                if (sourceCollection == null || sourceCollection.Id == Model.Collection!.Id) continue;

                                var isCompatible = sourceCollection.RequiredLpiVersionId == Model.Collection.RequiredLpiVersionId &&
                                                   sourceCollection.RequiredPiccoloVersionId == Model.Collection.RequiredPiccoloVersionId;

                                <tr class="feature-row" data-collection-id="@sourceCollection.Id" data-category="@feature.Category" data-feature-name="@feature.Name.ToLower()">
                                    <td>
                                        <strong>@feature.Name</strong>
                                        <br />
                                        <small class="text-muted">@feature.Description</small>
                                        <br />
                                        <span class="badge bg-info">@feature.Parameters.Count params</span>
                                        <span class="badge bg-secondary">@feature.Commands.Count commands</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@sourceCollection.Name</span>
                                        <br />
                                        <small class="text-muted">
                                            @sourceCollection.TargetProgram?.Name
                                        </small>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@feature.Category</span>
                                    </td>
                                    <td>
                                        @if (isCompatible)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> Compatible</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> Incompatible</span>
                                            <br />
                                            <small class="text-muted">Will require adaptation</small>
                                        }
                                    </td>
                                    <td>
                                        @if (isCompatible)
                                        {
                                            <form method="post" asp-page-handler="PullFeature" class="d-inline">
                                                <input type="hidden" name="id" value="@Model.Collection!.Id" />
                                                <input type="hidden" name="sourceFeatureId" value="@feature.Id" />
                                                <input type="hidden" name="adaptToVersion" value="false" />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-arrow-down-circle"></i> Pull
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-warning" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#adaptModal"
                                                    data-feature-id="@feature.Id"
                                                    data-feature-name="@feature.Name">
                                                <i class="bi bi-arrow-down-circle"></i> Pull & Adapt
                                            </button>
                                        }
                                        <a href="/Features/Edit?id=@feature.Id" class="btn btn-sm btn-outline-info" target="_blank">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Adaptation Wizard Modal -->
<div class="modal fade" id="adaptModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="bi bi-tools"></i> Adapt Feature for Compatibility</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="PullFeature">
                <div class="modal-body">
                    <input type="hidden" name="id" value="@Model.Collection?.Id" />
                    <input type="hidden" id="adaptFeatureId" name="sourceFeatureId" value="" />
                    <input type="hidden" name="adaptToVersion" value="true" />

                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i> 
                        This feature is not compatible with the current collection's firmware versions.
                        Adaptation will attempt to map parameters and commands to compatible equivalents.
                    </div>

                    <h6>Feature: <strong id="adaptFeatureName"></strong></h6>
                    <p class="text-muted">
                        Source firmware: <strong id="adaptSourceVersions"></strong><br />
                        Target firmware: <strong>LPI @Model.Collection?.RequiredLpiVersion?.Version + PICCOLO @Model.Collection?.RequiredPiccoloVersion?.Version</strong>
                    </p>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="autoAdaptCheck" checked>
                        <label class="form-check-label" for="autoAdaptCheck">
                            <strong>Automatically adapt parameters and commands</strong>
                            <br />
                            <small class="text-muted">System will map parameter IDs and command IDs to equivalent versions where possible</small>
                        </label>
                    </div>

                    <div class="alert alert-info mt-3">
                        <strong>What happens during adaptation:</strong>
                        <ul>
                            <li>Parameter IDs are mapped to target firmware version equivalents</li>
                            <li>Command IDs are substituted with compatible commands</li>
                            <li>Incompatible parameters/commands are flagged for manual review</li>
                            <li>Feature is copied (original remains unchanged)</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Pull & Adapt Feature</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Feature search and filter
    document.getElementById('featureSearchInput')?.addEventListener('input', filterFeatures);
    document.getElementById('collectionFilter')?.addEventListener('change', filterFeatures);
    document.getElementById('categoryFilter')?.addEventListener('change', filterFeatures);

    function filterFeatures() {
        const searchTerm = document.getElementById('featureSearchInput')?.value.toLowerCase() || '';
        const collectionId = document.getElementById('collectionFilter')?.value || '';
        const category = document.getElementById('categoryFilter')?.value || '';

        const rows = document.querySelectorAll('.feature-row');
        rows.forEach(row => {
            const featureName = row.getAttribute('data-feature-name') || '';
            const rowCollectionId = row.getAttribute('data-collection-id') || '';
            const rowCategory = row.getAttribute('data-category') || '';

            const matchesSearch = featureName.includes(searchTerm);
            const matchesCollection = !collectionId || rowCollectionId === collectionId;
            const matchesCategory = !category || rowCategory === category;

            row.style.display = (matchesSearch && matchesCollection && matchesCategory) ? '' : 'none';
        });
    }

    // Adapt modal - populate feature details
    const adaptModal = document.getElementById('adaptModal');
    adaptModal?.addEventListener('show.bs.modal', function(event) {
        const button = event.relatedTarget;
        const featureId = button.getAttribute('data-feature-id');
        const featureName = button.getAttribute('data-feature-name');

        document.getElementById('adaptFeatureId').value = featureId;
        document.getElementById('adaptFeatureName').textContent = featureName;
    });
</script>
}
