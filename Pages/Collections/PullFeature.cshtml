@page
@model WebApp.Pages.Collections.PullFeatureModel
@{
    ViewData["Title"] = "Pull Feature from Collection";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1>
                <i class="bi bi-arrow-left-right text-primary"></i>
                Pull Feature from Another Collection
            </h1>
            <p class="text-muted">Find and import features from other collections into your current collection</p>
        </div>
        <div class="col-auto">
            <a href="/Collections" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Collections
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Source Selection -->
        <div class="col-md-4">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-gear"></i> Select Source & Target</h5>
                </div>
                <div class="card-body">
                    <form method="get">
                        <div class="mb-3">
                            <label for="targetCollectionId" class="form-label fw-bold">Target Collection</label>
                            <select class="form-select" id="targetCollectionId" name="targetCollectionId" onchange="this.form.submit()">
                                <option value="">-- Select target collection --</option>
                                @foreach (var collection in Model.AvailableCollections)
                                {
                                    <option value="@collection.Id" selected="@(collection.Id == Model.TargetCollectionId)">
                                        @collection.Name
                                    </option>
                                }
                            </select>
                            <div class="form-text">The collection you want to add features to</div>
                        </div>

                        <div class="mb-3">
                            <label for="sourceCollectionId" class="form-label fw-bold">Source Collection</label>
                            <select class="form-select" id="sourceCollectionId" name="sourceCollectionId" onchange="this.form.submit()">
                                <option value="">-- Select source collection --</option>
                                @foreach (var collection in Model.AvailableCollections.Where(c => c.Id != Model.TargetCollectionId))
                                {
                                    <option value="@collection.Id" selected="@(collection.Id == Model.SourceCollectionId)">
                                        @collection.Name (@collection.Features.Count features)
                                    </option>
                                }
                            </select>
                            <div class="form-text">The collection to pull features from</div>
                        </div>
                    </form>

                    @if (Model.TargetCollection != null)
                    {
                        <div class="alert alert-info small">
                            <strong>Target Context:</strong><br/>
                            LPI: @Model.TargetCollection.RequiredLpiVersion?.Version<br/>
                            PICCOLO: @Model.TargetCollection.RequiredPiccoloVersion?.Version
                        </div>
                    }
                </div>
            </div>

            <!-- Compatibility Legend -->
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h6 class="mb-0"><i class="bi bi-info-circle"></i> Compatibility Legend</h6>
                </div>
                <div class="card-body small">
                    <div class="mb-2">
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle"></i> Compatible
                        </span>
                        Can be pulled directly
                    </div>
                    <div class="mb-2">
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-exclamation-triangle"></i> Needs Adaptation
                        </span>
                        Requires modifications
                    </div>
                    <div>
                        <span class="badge bg-danger">
                            <i class="bi bi-x-circle"></i> Incompatible
                        </span>
                        Cannot be adapted
                    </div>
                </div>
            </div>
        </div>

        <!-- Available Features -->
        <div class="col-md-8">
            @if (Model.SourceCollection != null && Model.TargetCollection != null)
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-white border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="bi bi-list-check"></i>
                                Available Features from "@Model.SourceCollection.Name"
                            </h5>
                            <span class="badge bg-primary">@Model.SourceFeatures.Count features</span>
                        </div>
                    </div>

                    @if (Model.SourceFeatures.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var feature in Model.SourceFeatures)
                            {
                                var compatibility = Model.GetCompatibilityStatus(feature);
                                var canPull = compatibility != "incompatible";

                                <div class="list-group-item">
                                    <div class="row align-items-center">
                                        <div class="col-md-6">
                                            <h6 class="mb-1">
                                                @feature.Name
                                                @if (compatibility == "compatible")
                                                {
                                                    <span class="badge bg-success ms-2">
                                                        <i class="bi bi-check-circle"></i> Compatible
                                                    </span>
                                                }
                                                else if (compatibility == "needs-adaptation")
                                                {
                                                    <span class="badge bg-warning text-dark ms-2">
                                                        <i class="bi bi-exclamation-triangle"></i> Needs Adaptation
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger ms-2">
                                                        <i class="bi bi-x-circle"></i> Incompatible
                                                    </span>
                                                }
                                            </h6>
                                            <p class="mb-1 text-muted small">@feature.Description</p>
                                            <div class="small text-muted">
                                                <span class="badge bg-light text-dark border me-1">
                                                    <i class="bi bi-sliders"></i> @(feature.Parameters?.Count ?? 0) params
                                                </span>
                                                <span class="badge bg-light text-dark border">
                                                    <i class="bi bi-command"></i> @(feature.Commands?.Count ?? 0) commands
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-md-3 text-center">
                                            @if (compatibility == "needs-adaptation")
                                            {
                                                <div class="small text-warning">
                                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                                    <div>@Model.GetCompatibilityDetails(feature)</div>
                                                </div>
                                            }
                                            else if (compatibility == "incompatible")
                                            {
                                                <div class="small text-danger">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                    <div>Version mismatch</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="small text-success">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    <div>Ready to pull</div>
                                                </div>
                                            }
                                        </div>
                                        <div class="col-md-3 text-end">
                                            @if (canPull)
                                            {
                                                <form method="post" asp-page-handler="Pull" class="d-inline">
                                                    <input type="hidden" name="featureId" value="@feature.Id" />
                                                    <input type="hidden" name="sourceCollectionId" value="@Model.SourceCollectionId" />
                                                    <input type="hidden" name="targetCollectionId" value="@Model.TargetCollectionId" />
                                                    <input type="hidden" name="adaptIfNeeded" value="@(compatibility == "needs-adaptation")" />
                                                    
                                                    @if (compatibility == "needs-adaptation")
                                                    {
                                                        <button type="submit" class="btn btn-warning btn-sm">
                                                            <i class="bi bi-wrench"></i> Pull & Adapt
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit" class="btn btn-success btn-sm">
                                                            <i class="bi bi-download"></i> Pull Feature
                                                        </button>
                                                    }
                                                </form>
                                                <a href="/Features/BytePacket?id=@feature.Id" 
                                                   class="btn btn-outline-secondary btn-sm ms-1"
                                                   title="Preview">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled>
                                                    <i class="bi bi-ban"></i> Cannot Pull
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="card-body text-center text-muted py-5">
                            <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                            <p class="mt-3">No features available in the source collection</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center text-muted py-5">
                        <i class="bi bi-arrow-left-right" style="font-size: 3rem;"></i>
                        <p class="mt-3 mb-0">
                            <strong>Select both source and target collections to begin</strong><br/>
                            <small>Choose collections from the panel on the left</small>
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* AI Chat Panel *@
@await Html.PartialAsync("_ChatPanel", Model.PullFeatureChatContext)

@section Scripts {
    <script>
        // Auto-submit form on collection selection
        // (handled by onchange in the select elements)
    </script>
}
