        function createOperation() {
            const name = document.getElementById('newOperationName').value || 'New Operation';
            const type = document.getElementById('selectedOperationType').value;
            const insertAfter = document.getElementById('insertAfterOperation').value;
            
            console.log(`Creating ${type} operation: ${name}, insert after: ${insertAfter || 'end'}`);
            
            // In a real implementation, this would:
            // 1. POST to server to create the operation
            // 2. Refresh the workflow section
            // For now, we'll create a demo operation in the DOM
            
            const operationHtml = createOperationHtml(name, type, Date.now());
            
            if (insertAfter) {
                // Insert after specific operation
                const targetButton = document.querySelector(`[onclick*="showAddOperationModal(${insertAfter})"]`);
                if (targetButton) {
                    const insertPoint = targetButton.closest('.text-center');
                    insertPoint.insertAdjacentHTML('afterend', operationHtml);
                }
            } else {
                // Insert at end
                const commandFlow = document.querySelector('.command-flow');
                if (commandFlow) {
                    commandFlow.insertAdjacentHTML('beforeend', operationHtml);
                }
            }
            
            bootstrap.Modal.getInstance(document.getElementById('addOperationModal')).hide();
        }
        
