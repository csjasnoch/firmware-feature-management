        function saveStep() {
            const body = document.getElementById('configureStepBody');
            const stepType = body.dataset.stepType;
            const operationId = body.dataset.operationId;
            const afterStepIdRaw = body.dataset.afterStepId;
            const afterStepId = afterStepIdRaw && afterStepIdRaw !== '' ? parseInt(afterStepIdRaw) : null;
            
            console.log(`Saving step of type ${stepType} to operation ${operationId} (after step: ${afterStepId ?? 'end'})`);

            // Locate operation body
            const operationCard = document.querySelector(`[data-operation-id="${operationId}"]`);
            const operationBody = operationCard?.querySelector('.card-body');
            if (!operationCard || !operationBody) {
                // Non-blocking notification
                if (typeof showToast === 'function') {
                    showToast('Could not find target operation container.', 'danger');
                } else {
                    console.warn('Could not find target operation container.');
                }
                return;
            }

            // Build new step card markup for supported types
            let newStepCard = document.createElement('div');
            newStepCard.className = 'card mb-2';
            newStepCard.style.marginLeft = '10px';
            newStepCard.setAttribute('data-step-id', 'NEW');
            newStepCard.setAttribute('data-operation-id', operationId);
            newStepCard.setAttribute('data-edit-mode', 'false');

            if (stepType === 'param-read') {
                // Validate parameter selection
                const selected = (typeof paramSearchState !== 'undefined') ? paramSearchState.selectedParam : null;
                const targetVar = document.getElementById('targetVariable')?.value || 'readValue';
                if (!selected) {
                    // Inline validation message instead of blocking alert
                    const input = document.getElementById('parameterSearchInput');
                    if (input) {
                        input.classList.add('is-invalid');
                        let msg = document.getElementById('paramValidationMessage');
                        if (!msg) {
                            msg = document.createElement('div');
                            msg.id = 'paramValidationMessage';
                            msg.className = 'invalid-feedback d-block';
                            input.parentElement?.appendChild(msg);
                        }
                        msg.textContent = 'Please select a parameter to read.';
                    }
                    return;
                }

                const titleText = `Read ${selected.name}`;
                const contextInfo = `${selected.context} › ${selected.group}`;
                const typeInfo = selected.type;

                newStepCard.innerHTML = `
                    <div class="card-body py-2 px-3">
                        <!-- VIEW MODE -->
                        <div class="step-view-mode" id="step-view-${operationId}-NEW">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-dark me-2" style="min-width: 55px;">Step NEW</span>
                                    <span class="fw-semibold me-2">${titleText}</span>
                                    <span class="badge bg-success ms-2">📖</span>
                                    <span class="small text-muted ms-2">${contextInfo} • ${typeInfo}</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <div class="btn-group btn-group-sm me-2 operation-edit-item" data-operation="${operationId}" style="display: none;">
                                        <button type="button" class="btn btn-outline-secondary" title="Move Up" onclick="event.stopPropagation(); moveStep(${operationId}, 'NEW', 'up')">↑</button>
                                        <button type="button" class="btn btn-outline-secondary" title="Move Down" onclick="event.stopPropagation(); moveStep(${operationId}, 'NEW', 'down')">↓</button>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" title="Edit Step" onclick="toggleStepEditMode(${operationId}, 'NEW')">⚙️</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Delete Step" onclick="confirmDeleteStep(${operationId}, 'NEW', '${titleText}')">🗑️</button>
                                </div>
                            </div>
                            <div class="small text-muted mt-1 ps-5">Store in variable: <strong>${targetVar}</strong></div>
                        </div>
                        
                        <!-- EDIT MODE -->
                        <div class="step-edit-mode" id="step-edit-${operationId}-NEW" style="display: none;">
                            <div class="d-flex align-items-center mb-2">
                                <span class="badge bg-dark me-2">Step NEW</span>
                                <strong class="me-2">${titleText}</strong>
                                <span class="badge bg-success ms-2">📖 Read</span>
                            </div>
                            <div class="small mb-2">
                                <strong>Parameter:</strong> ${selected.name} <span class="badge bg-secondary ms-1" style="font-size: 11px;">${typeInfo}</span><br>
                                <span class="text-muted">${contextInfo}</span>
                            </div>
                            <div class="small mb-2"><strong>Store In:</strong> ${targetVar}</div>
                            <div class="mt-3 pt-2 border-top">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div></div>
                                    <div>
                                        <button type="button" class="btn btn-sm btn-success me-1" onclick="saveStepChanges(${operationId}, 'NEW')">✓ Done</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleStepEditMode(${operationId}, 'NEW')">Cancel</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger ms-2" title="Delete Step" onclick="confirmDeleteStep(${operationId}, 'NEW', '${titleText}')">🗑️</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            } else {
                // Default placeholder for unsupported types in demo
                newStepCard.innerHTML = `
                    <div class="card-body py-2 px-3">
                        <div class="step-view-mode" id="step-view-${operationId}-NEW">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-dark me-2" style="min-width: 55px;">Step NEW</span>
                                    <span class="fw-semibold me-2">${stepType}</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <div class="btn-group btn-group-sm me-2 operation-edit-item" data-operation="${operationId}" style="display: none;">
                                        <button type="button" class="btn btn-outline-secondary" title="Move Up" onclick="event.stopPropagation(); moveStep(${operationId}, 'NEW', 'up')">↑</button>
                                        <button type="button" class="btn btn-outline-secondary" title="Move Down" onclick="event.stopPropagation(); moveStep(${operationId}, 'NEW', 'down')">↓</button>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" title="Edit Step" onclick="toggleStepEditMode(${operationId}, 'NEW')">⚙️</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Delete Step" onclick="confirmDeleteStep(${operationId}, 'NEW', '${stepType}')">🗑️</button>
                                </div>
                            </div>
                        </div>
                        <div class="step-edit-mode" id="step-edit-${operationId}-NEW" style="display: none;">
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <div></div>
                                <div>
                                    <button type="button" class="btn btn-sm btn-success me-1" onclick="saveStepChanges(${operationId}, 'NEW')">✓ Done</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleStepEditMode(${operationId}, 'NEW')">Cancel</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-2" title="Delete Step" onclick="confirmDeleteStep(${operationId}, 'NEW', '${stepType}')">🗑️</button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            // Insert card at desired position
            if (afterStepId !== null) {
                const afterCard = operationBody.querySelector(`:scope > [data-step-id="${afterStepId}"]`);
                if (afterCard) {
                    afterCard.after(newStepCard);
                } else {
                    operationBody.appendChild(newStepCard);
                }
            } else {
                // Insert before final "Add Step to This Operation" row if present
                const endAddRow = operationBody.querySelector(':scope > .operation-edit-item.border-top');
                if (endAddRow) {
                    operationBody.insertBefore(newStepCard, endAddRow);
                } else {
                    operationBody.appendChild(newStepCard);
                }
            }

            // Renumber and refresh UI helpers
            updateStepNumbers(parseInt(operationId));
            rebuildAddStepButtons(parseInt(operationId));
            updateStepCount(parseInt(operationId));

            // Close modal (no blocking alert)
            bootstrap.Modal.getInstance(document.getElementById('configureStepModal')).hide();
        }

        // Lightweight toast helper (non-blocking)
        function showToast(message, variant = 'info') {
            let container = document.getElementById('toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toast-container';
                container.style.position = 'fixed';
                container.style.top = '12px';
                container.style.right = '12px';
                container.style.zIndex = '1060';
                document.body.appendChild(container);
            }
            const toast = document.createElement('div');
            toast.className = `alert alert-${variant} shadow-sm py-2 px-3 mb-2`;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 2500);
        }
        
