        function showAddStepModal(operationId, afterStepId = null) {
            document.getElementById('insertInOperation').value = operationId;
            document.getElementById('insertAfterStep').value = afterStepId || '';
            document.getElementById('selectedStepType').value = '';
            document.getElementById('createStepBtn').disabled = true;
            
            // Reset card selections
            document.querySelectorAll('.step-type-card').forEach(card => {
                card.classList.remove('border-primary', 'bg-light');
            });
            
            new bootstrap.Modal(document.getElementById('addStepModal')).show();
        }
        
        function selectStepType(type) {
            document.getElementById('selectedStepType').value = type;
            document.getElementById('createStepBtn').disabled = false;
            
            // Update card visual selection
            document.querySelectorAll('.step-type-card').forEach(card => {
                card.classList.remove('border-primary', 'bg-light');
            });
            event.currentTarget.classList.add('border-primary', 'bg-light');
        }
        
