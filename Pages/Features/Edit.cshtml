        // Toggle operation edit mode
        function toggleOperationEditMode(operationId) {
            const operationCard = document.querySelector(`[data-operation-id="${operationId}"]`);
            if (!operationCard) return;
            
            const isEditMode = operationCard.dataset.editMode === 'true';
            const editControls = document.getElementById(`operation-edit-controls-${operationId}`);
            const editBtn = document.getElementById(`operation-edit-btn-${operationId}`);
            const editItems = document.querySelectorAll(`.operation-edit-item[data-operation="${operationId}"]`);
            
            if (isEditMode) {
                // Switch to VIEW mode
                operationCard.dataset.editMode = 'false';
                editControls.style.display = 'none';
                editBtn.classList.remove('btn-primary');
                editBtn.classList.add('btn-outline-secondary');
                editBtn.title = 'Edit Operation';
                editItems.forEach(item => item.style.display = 'none');
                operationCard.classList.remove('border-primary', 'edit-mode-active');
                
                // Reset all step edit modes within this operation
                operationCard.querySelectorAll('[data-step-id]').forEach(step => {
                    toggleStepEditMode(operationId, step.dataset.stepId, true); // Force to view mode
                });
            } else {
                // Switch to EDIT mode
                operationCard.dataset.editMode = 'true';
                editControls.style.display = 'inline-block';
                editBtn.classList.remove('btn-outline-secondary');
                editBtn.classList.add('btn-primary');
                editBtn.title = 'Exit Edit Mode';
                editItems.forEach(item => item.style.display = 'block');
                operationCard.classList.add('edit-mode-active');
            }
        }
        
        // Toggle step edit mode
        function toggleStepEditMode(operationId, stepId, forceView = false) {
            const stepCard = document.querySelector(`[data-step-id="${stepId}"][data-operation-id="${operationId}"]`);
            if (!stepCard) return;
            
            const viewMode = document.getElementById(`step-view-${operationId}-${stepId}`);
            const editMode = document.getElementById(`step-edit-${operationId}-${stepId}`);
            
            if (!viewMode || !editMode) return;
            
            const isEditMode = stepCard.dataset.editMode === 'true';
            
            if (forceView || isEditMode) {
                // Switch to VIEW mode
                stepCard.dataset.editMode = 'false';
                viewMode.style.display = 'block';
                editMode.style.display = 'none';
                stepCard.classList.remove('border-primary', 'edit-mode-active');
            } else {
                // Switch to EDIT mode
                stepCard.dataset.editMode = 'true';
                viewMode.style.display = 'none';
                editMode.style.display = 'block';
                stepCard.classList.add('border-primary', 'edit-mode-active');
            }
        }
        
