            // Aid Identification
            { name: "SerialNumber", type: "String", description: "Device serial number", context: "AidIdentification", group: "AidIdentification", id: 44 },
            { name: "ModelNumber", type: "String", description: "Device model number", context: "AidIdentification", group: "AidIdentification", id: 45 },
            { name: "FirmwareVersion", type: "String", description: "Current firmware version", context: "AidIdentification", group: "AidIdentification", id: 46 },
            { name: "Side", type: "Enum", description: "Left or Right ear device", context: "AidIdentification", group: "AidIdentification", id: 47 },
            
            // Environment Classification
            { name: "CurrentEnvironment", type: "Enum", description: "Detected acoustic environment", context: "EnvironmentClassificationStatus", group: "AdvancedEnvironmentClassificationStatus", id: 48 },
            { name: "EnvironmentConfidence", type: "UInt8", description: "Classification confidence (0-100)", context: "EnvironmentClassificationStatus", group: "AdvancedEnvironmentClassificationStatus", id: 49 },
            { name: "SpeechInNoiseDetected", type: "Boolean", description: "Speech in noise detected flag", context: "EnvironmentClassificationStatus", group: "AdvancedEnvironmentClassificationStatus", id: 50 },
            
            // User Controls
            { name: "VolumeLevel", type: "Int8", description: "User volume adjustment (-12 to +12 dB)", context: "UserControls", group: "UiControlsPerMemory", id: 51 },
            { name: "CurrentMemoryIndex", type: "UInt8", description: "Active memory/program index", context: "UserControls", group: "UiControlsPerMemory", id: 52 },
            { name: "MuteEnabled", type: "Boolean", description: "Audio mute state", context: "UserControls", group: "UiControlsPerMemory", id: 53 },
            { name: "StreamingMixRatio", type: "UInt8", description: "Streaming vs ambient audio mix (0-100)", context: "UserControls", group: "StreamingControls", id: 54 },
        ];
        
        // Build lookup indexes for fast searching
        const contextSet = [...new Set(parameterDatabase.map(p => p.context))].sort();
        const groupSet = [...new Set(parameterDatabase.map(p => p.group))].sort();
        
        // Parameter search state
        let paramSearchState = {
            searchText: '',
            selectedParam: null,
            filteredResults: [],
            highlightIndex: 0
        };
        
        function searchParameters(searchText) {
            if (!searchText || searchText.length < 1) {
                return parameterDatabase.slice(0, 20); // Show first 20 when empty
            }
            
            const search = searchText.toLowerCase();
            const results = parameterDatabase.filter(p => 
                p.name.toLowerCase().includes(search) ||
                p.context.toLowerCase().includes(search) ||
                p.group.toLowerCase().includes(search) ||
                p.description.toLowerCase().includes(search)
            );
            
            // Sort by relevance (exact name match first, then name starts with, then others)
            results.sort((a, b) => {
                const aNameLower = a.name.toLowerCase();
                const bNameLower = b.name.toLowerCase();
                
                // Exact match
                if (aNameLower === search) return -1;
                if (bNameLower === search) return 1;
                
                // Starts with
                if (aNameLower.startsWith(search) && !bNameLower.startsWith(search)) return -1;
                if (bNameLower.startsWith(search) && !aNameLower.startsWith(search)) return 1;
                
                // Name contains vs context/group contains
                if (aNameLower.includes(search) && !bNameLower.includes(search)) return -1;
                if (bNameLower.includes(search) && !aNameLower.includes(search)) return 1;
                
                return a.name.localeCompare(b.name);
            });
            
            return results.slice(0, 30); // Limit to 30 results
        }
        
        function renderParameterDropdown(results, containerId, highlightIndex = 0) {
            const container = document.getElementById(containerId);
            if (!container) return;
            
            if (results.length === 0) {
                container.innerHTML = '<div class="p-3 text-muted text-center">No parameters found</div>';
                container.style.display = 'block';
                return;
            }
            
            const html = results.map((param, idx) => `
                <div class="param-result-item ${idx === highlightIndex ? 'highlighted' : ''}" 
                     data-param-id="${param.id}"
                     data-param-name="${param.name}"
                     data-param-context="${param.context}"
                     data-param-group="${param.group}"
                     onmouseover="highlightParamResult(${idx}, '${containerId}')"
                     onclick="selectParamFromDropdown(${param.id})">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="param-name fw-semibold">${highlightMatch(param.name, paramSearchState.searchText)}</span>
                            <span class="badge bg-secondary ms-1" style="font-size: 10px;">${param.type}</span>
                        </div>
                    </div>
                    <div class="param-location text-muted" style="font-size: 11px;">
                        <span class="text-primary">${highlightMatch(param.context, paramSearchState.searchText)}</span>
                        <span class="mx-1">›</span>
                        <span class="text-info">${highlightMatch(param.group, paramSearchState.searchText)}</span>
                    </div>
                    <div class="param-desc text-muted" style="font-size: 11px;">${param.description}</div>
                </div>
            `).join('');
            
            container.innerHTML = html;
            container.style.display = 'block';
        }
        
        function highlightMatch(text, search) {
            if (!search || search.length < 1) return text;
            const regex = new RegExp(`(${search.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
            return text.replace(regex, '<mark>$1</mark>');
        }
        
        function highlightParamResult(index, containerId) {
            const container = document.getElementById(containerId);
            if (!container) return;
            
            const items = container.querySelectorAll('.param-result-item');
            items.forEach((item, idx) => {
                item.classList.toggle('highlighted', idx === index);
            });
            paramSearchState.highlightIndex = index;
        }
        
        function selectParamFromDropdown(paramId) {
            const param = parameterDatabase.find(p => p.id === paramId);
            if (!param) return;
            
            paramSearchState.selectedParam = param;
            
            // Update the input field
            const input = document.getElementById('parameterSearchInput');
            if (input) {
                input.value = param.name;
            }
            
            // Update the selected parameter display
            const selectedDisplay = document.getElementById('selectedParamDisplay');
            if (selectedDisplay) {
                selectedDisplay.innerHTML = `
                    <div class="alert alert-success py-2 mb-0">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>${param.name}</strong>
                                <span class="badge bg-secondary ms-1">${param.type}</span>
                            </div>
                            <button type="button" class="btn-close btn-sm" onclick="clearParamSelection()"></button>
                        </div>
                        <div style="font-size: 12px;" class="mt-1">
                            <span class="text-primary">${param.context}</span>
                            <span class="mx-1">›</span>
                            <span class="text-info">${param.group}</span>
                        </div>
                        <div class="text-muted" style="font-size: 12px;">${param.description}</div>
                    </div>
                `;
                selectedDisplay.style.display = 'block';
            }
            
            // Hide the dropdown
            const dropdown = document.getElementById('paramSearchDropdown');
            if (dropdown) {
                dropdown.style.display = 'none';
            }
            
            // Enable the Add Step button
            const addBtn = document.getElementById('createStepBtn');
            if (addBtn) {
                addBtn.disabled = false;
            }
        }
        
        function clearParamSelection() {
            paramSearchState.selectedParam = null;
            paramSearchState.searchText = '';
            
            const input = document.getElementById('parameterSearchInput');
            if (input) input.value = '';
            
            const selectedDisplay = document.getElementById('selectedParamDisplay');
            if (selectedDisplay) selectedDisplay.style.display = 'none';
            
            const addBtn = document.getElementById('createStepBtn');
            if (addBtn) addBtn.disabled = true;
        }
        
        function initParameterSearch(inputId, dropdownId) {
            const input = document.getElementById(inputId);
            if (!input) return;
            
            // Show dropdown on focus
            input.addEventListener('focus', () => {
                paramSearchState.searchText = input.value;
                const results = searchParameters(input.value);
                paramSearchState.filteredResults = results;
                paramSearchState.highlightIndex = 0;
                renderParameterDropdown(results, dropdownId, 0);
            });
            
            // Search on input
            input.addEventListener('input', (e) => {
                paramSearchState.searchText = e.target.value;
                const results = searchParameters(e.target.value);
                paramSearchState.filteredResults = results;
                paramSearchState.highlightIndex = 0;
                renderParameterDropdown(results, dropdownId, 0);
            });
            
            // Keyboard navigation
            input.addEventListener('keydown', (e) => {
                const dropdown = document.getElementById(dropdownId);
                if (!dropdown || dropdown.style.display === 'none') return;
                
                const results = paramSearchState.filteredResults;
                
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    paramSearchState.highlightIndex = Math.min(paramSearchState.highlightIndex + 1, results.length - 1);
                    highlightParamResult(paramSearchState.highlightIndex, dropdownId);
                    scrollToHighlighted(dropdownId);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    paramSearchState.highlightIndex = Math.max(paramSearchState.highlightIndex - 1, 0);
                    highlightParamResult(paramSearchState.highlightIndex, dropdownId);
                    scrollToHighlighted(dropdownId);
                } else if (e.key === 'Tab' || e.key === 'Enter') {
                    e.preventDefault();
                    const highlighted = results[paramSearchState.highlightIndex];
                    if (highlighted) {
                        selectParamFromDropdown(highlighted.id);
                    }
                } else if (e.key === 'Escape') {
                    dropdown.style.display = 'none';
                }
            });
            
            // Hide dropdown on click outside
            document.addEventListener('click', (e) => {
                const dropdown = document.getElementById(dropdownId);
                if (dropdown && !input.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.style.display = 'none';
                }
            });
        }
        
        function scrollToHighlighted(containerId) {
            const container = document.getElementById(containerId);
            const highlighted = container?.querySelector('.param-result-item.highlighted');
            if (highlighted) {
                highlighted.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }
        }
        
