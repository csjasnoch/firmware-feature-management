                        <span class="expand-icon">▶</span> ${context.context}
                    </div>
                    <div class="context-content" style="display: none; margin-left: 20px;">
                        ${context.groups.map(group => `
                            <div class="mb-2">
                                <div class="fw-semibold mb-1" style="cursor: pointer;" onclick="toggleGroup(this)">
                                    <span class="expand-icon">▶</span> ${group.name}
                                </div>
                                <div class="group-content" style="display: none; margin-left: 20px;">
                                    ${group.parameters.map(param => `
                                        <div class="param-item p-2 border-bottom" style="cursor: pointer;" onclick="selectParameter('${param.name}', '${param.type}', '${mode}', ${stepId})">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong>${param.name}</strong>
                                                    <span class="badge bg-secondary ms-2">${param.type}</span>
                                                </div>
                                                <button class="btn btn-sm btn-primary">+ Add ${mode}</button>
                                            </div>
                                            <div class="small text-muted">${param.description}</div>
                                        </div>
                                    `).join('')}
                                </div>
                            </div>
                        `).join('')}
                    </div>
                `;
                hierarchyContainer.appendChild(contextDiv);
            });
            
            document.getElementById('linkMode').value = mode;
            document.getElementById('linkStepId').value = stepId;
            new bootstrap.Modal(modal).show();
        }
        
        function toggleContext(element) {
            const content = element.nextElementSibling;
            const icon = element.querySelector('.expand-icon');
            if (content.style.display === 'none') {
                content.style.display = 'block';
                icon.textContent = '▼';
            } else {
                content.style.display = 'none';
                icon.textContent = '▶';
            }
        }
        
        function toggleGroup(element) {
            const content = element.nextElementSibling;
            const icon = element.querySelector('.expand-icon');
            if (content.style.display === 'none') {
                content.style.display = 'block';
                icon.textContent = '▼';
            } else {
                content.style.display = 'none';
                icon.textContent = '▶';
            }
        }
        
        function selectParameter(paramName, paramType, mode, stepId) {
            // In real implementation, this would make an AJAX call to add the parameter link
            // For now, just close the modal - actual linking will be implemented server-side
            bootstrap.Modal.getInstance(document.getElementById('linkParameterModal')).hide();
            
            // TODO: Implement actual parameter linking
            // - POST to server with stepId, paramName, and mode (Read/Write)
            // - Refresh the command section to show the new parameter link
            // - Update the "Used Parameters" section at the top
        }
        
        // Search parameters
        document.getElementById('parameterHierarchySearch')?.addEventListener('input', function(e) {
            const search = e.target.value.toLowerCase();
            const paramItems = document.querySelectorAll('.param-item');
            paramItems.forEach(item => {
                const text = item.textContent.toLowerCase();
                item.style.display = text.includes(search) ? '' : 'none';
                
                // Show parent group and context if param matches
                if (text.includes(search) && search.length > 0) {
                    let parent = item.closest('.group-content');
                    if (parent) {
                        parent.style.display = 'block';
                        parent.previousElementSibling.querySelector('.expand-icon').textContent = '▼';
                    }
                    parent = item.closest('.context-content');
                    if (parent) {
                        parent.style.display = 'block';
                        parent.previousElementSibling.querySelector('.expand-icon').textContent = '▼';
                    }
                }
            });
        });
        
        // Decision Point functionality
