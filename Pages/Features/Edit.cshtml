@page
@model WebApp.Pages.Features.EditModel
@{
    ViewData["Title"] = $"Edit Feature: {Model.Feature?.Name}";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/Features">Features</a></li>
                    <li class="breadcrumb-item active">@Model.Feature?.Name</li>
                </ol>
            </nav>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Feature != null)
    {
        <div class="row mb-4">
            <div class="col">
                <h2>⚙️ Edit Feature</h2>
            </div>
            <div class="col-auto">
                <a href="/Features" class="btn btn-outline-secondary">Back to Features</a>
                <button type="button" class="btn btn-primary" onclick="document.getElementById('featureForm').submit()">
                    💾 Save Changes
                </button>
            </div>
        </div>

        <!-- Feature Details -->
        <form id="featureForm" method="post">
            <div class="card mb-4">
                <div class="card-header">
                    <strong>Feature Details</strong>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Name *</label>
                            <input type="text" class="form-control" asp-for="Feature.Name" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Owner</label>
                            <input type="text" class="form-control" asp-for="Feature.Owner" readonly />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" asp-for="Feature.Description" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <small class="text-muted">Created: @Model.Feature.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">Modified: @Model.Feature.ModifiedAt.ToString("yyyy-MM-dd HH:mm")</small>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <!-- Current Firmware Context -->
        <div class="card mb-4">
            <div class="card-header bg-info text-white">
                <strong>📌 Current Firmware Context</strong>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <strong>LPI Version:</strong> @Model.CurrentLpiVersion?.Version (@Model.CurrentLpiVersion?.Stage)
                        <div class="small text-muted">@Model.AvailableParameters.Count parameters available</div>
                    </div>
                    <div class="col-md-6">
                        <strong>PICCOLO Version:</strong> @Model.CurrentPiccoloVersion?.Version (@Model.CurrentPiccoloVersion?.Stage)
                        <div class="small text-muted">@Model.AvailableCommands.Count commands available</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- LPI Parameters -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>LPI Parameters (@Model.Feature.Parameters.Count)</strong>
                <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addParameterModal">
                    + Add Parameter
                </button>
            </div>
            <div class="card-body">
                @if (Model.Feature.Parameters.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th style="width: 30%">Parameter</th>
                                    <th style="width: 40%">Value</th>
                                    <th style="width: 20%">Range</th>
                                    <th style="width: 10%">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var param in Model.Feature.Parameters)
                                {
                                    var paramDef = Model.AvailableParameters.FirstOrDefault(p => p.Id == param.ParameterId);
                                    <tr>
                                        <td>
                                            <strong>@param.ParameterName</strong>
                                            <div class="small text-muted">ID: @param.ParameterId</div>
                                            @if (paramDef?.IsDeprecated == true)
                                            {
                                                <span class="badge bg-warning">⚠️ Deprecated</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="row align-items-center">
                                                <div class="col-8">
                                                    <input type="range" 
                                                           class="form-range" 
                                                           min="@(paramDef?.MinValue ?? 0)" 
                                                           max="@(paramDef?.MaxValue ?? 100)" 
                                                           value="@param.Value"
                                                           onchange="document.getElementById('value-@param.Id').value = this.value">
                                                </div>
                                                <div class="col-4">
                                                    <input type="number" 
                                                           id="value-@param.Id"
                                                           class="form-control form-control-sm" 
                                                           value="@param.Value"
                                                           min="@(paramDef?.MinValue ?? 0)" 
                                                           max="@(paramDef?.MaxValue ?? 100)">
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(param.Notes))
                                            {
                                                <div class="small text-muted mt-1">📝 @param.Notes</div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@(paramDef?.MinValue ?? 0) - @(paramDef?.MaxValue ?? 100)</span>
                                            <div class="small text-muted">Default: @(paramDef?.DefaultValue ?? 50)</div>
                                        </td>
                                        <td>
                                            <form method="post" asp-page-handler="RemoveParameter" style="display:inline">
                                                <input type="hidden" name="id" value="@Model.Feature.Id" />
                                                <input type="hidden" name="parameterId" value="@param.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                        onclick="return confirm('Remove this parameter?')">
                                                    🗑️
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <p class="text-muted">No parameters configured yet</p>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addParameterModal">
                            + Add First Parameter
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- PICCOLO Commands -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>PICCOLO Commands - State Machine Flow (@Model.Feature.Commands.Count)</strong>
                <button type="button" class="btn btn-sm btn-success" disabled>
                    + Add Command
                </button>
            </div>
            <div class="card-body">
                @if (Model.Feature.Commands.Any())
                {
                    <div class="alert alert-info mb-3">
                        <strong>💡 Command Execution Flow:</strong> Commands execute sequentially. Use status checks to determine next steps. Click a command to view/edit branching logic.
                    </div>
                    
                    <div class="command-flow">
                        @{
                            var orderedCommands = Model.Feature.Commands.OrderBy(c => c.ExecutionOrder).ToList();
                            for (int i = 0; i < orderedCommands.Count; i++)
                            {
                                var cmd = orderedCommands[i];
                                var isStatusCheck = cmd.CommandName.Contains("GetStatus") || cmd.CommandName.Contains("Check");
                                var isDecisionPoint = isStatusCheck && i < orderedCommands.Count - 1;
                                
                                <div class="card mb-2 @(isStatusCheck ? "border-warning" : "border-primary")" style="margin-left: 20px;">
                                    <div class="card-body py-2">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <div class="d-flex align-items-center mb-1">
                                                    <span class="badge @(isStatusCheck ? "bg-warning" : "bg-primary") me-2">
                                                        Step @cmd.ExecutionOrder
                                                    </span>
                                                    <strong class="me-2">@cmd.CommandName</strong>
                                                    <code class="small">@string.Format("0x{0:X2}", cmd.CommandCode)</code>
                                                    @if (isStatusCheck)
                                                    {
                                                        <span class="badge bg-info ms-2">🔍 Status Check</span>
                                                    }
                                                </div>
                                                
                                                @if (!string.IsNullOrEmpty(cmd.Notes))
                                                {
                                                    <div class="small text-muted mb-1">
                                                        📝 @cmd.Notes
                                                    </div>
                                                }
                                                
                                                @if (cmd.Payload.Any())
                                                {
                                                    <div class="small">
                                                        <strong>Payload:</strong> 
                                                        <code>[@string.Join(", ", cmd.Payload.Select(b => $"0x{b:X2}"))]</code>
                                                    </div>
                                                }
                                                
                                                @if (isDecisionPoint)
                                                {
                                                    <div class="mt-2 p-2 bg-light rounded">
                                                        <strong class="small">Decision Point:</strong>
                                                        <div class="small mt-1">
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" name="branch-@cmd.Id" id="success-@cmd.Id" checked>
                                                                <label class="form-check-label text-success" for="success-@cmd.Id">
                                                                    ✓ Success → Continue to Step @(cmd.ExecutionOrder + 1)
                                                                </label>
                                                            </div>
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" name="branch-@cmd.Id" id="failure-@cmd.Id">
                                                                <label class="form-check-label text-danger" for="failure-@cmd.Id">
                                                                    ✗ Failure → 
                                                                    <select class="form-select form-select-sm d-inline-block" style="width: auto;">
                                                                        <option>Reset & Retry</option>
                                                                        <option>Skip to Rollback</option>
                                                                        <option>Abort Process</option>
                                                                        <option>Log Error & Continue</option>
                                                                    </select>
                                                                </label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            <div class="ms-2">
                                                <button type="button" class="btn btn-sm btn-outline-secondary me-1" 
                                                        title="Edit command">⚙️</button>
                                                <button type="button" class="btn btn-sm btn-outline-danger" 
                                                        title="Remove command">🗑️</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                @if (i < orderedCommands.Count - 1)
                                {
                                    <div class="text-center" style="margin-left: 40px;">
                                        <div style="width: 2px; height: 20px; background-color: #0d6efd; margin: 0 auto;"></div>
                                        <div style="width: 0; height: 0; border-left: 6px solid transparent; border-right: 6px solid transparent; border-top: 8px solid #0d6efd; margin: 0 auto;"></div>
                                    </div>
                                }
                            }
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <p class="text-muted">No commands configured</p>
                    </div>
                }
            </div>
        </div>

        <!-- Validation & Preview -->
        <div class="row">
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <strong>✓ Validation</strong>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-0">
                            <li class="text-success">✓ Feature name is valid</li>
                            <li class="text-success">✓ @Model.Feature.Parameters.Count parameter(s) configured</li>
                            <li class="text-success">✓ All parameters within valid ranges</li>
                            @if (!Model.Feature.Parameters.Any())
                            {
                                <li class="text-warning">⚠️ No parameters defined</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <strong>📋 Actions</strong>
                    </div>
                    <div class="card-body">
                        <button type="button" class="btn btn-outline-primary mb-2 w-100">📤 Export Feature</button>
                        <button type="button" class="btn btn-outline-secondary mb-2 w-100">📋 Duplicate Feature</button>
                        <button type="button" class="btn btn-outline-info mb-2 w-100">🔍 Test on Device</button>
                        <hr />
                        <button type="button" class="btn btn-outline-danger w-100">🗑️ Delete Feature</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Add Parameter Modal -->
<div class="modal fade" id="addParameterModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add LPI Parameter</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" class="form-control" id="parameterSearch" placeholder="🔍 Search parameters...">
                </div>
                <div class="list-group" style="max-height: 400px; overflow-y: auto;">
                    @foreach (var param in Model.AvailableParameters.Take(20))
                    {
                        var alreadyAdded = Model.Feature?.Parameters.Any(p => p.ParameterId == param.Id) ?? false;
                        <div class="list-group-item @(alreadyAdded ? "disabled" : "")">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@param.Name</strong>
                                    <div class="small text-muted">
                                        ID: @param.Id | Range: @param.MinValue - @param.MaxValue | Default: @param.DefaultValue
                                    </div>
                                    @if (!string.IsNullOrEmpty(param.Description))
                                    {
                                        <div class="small">@param.Description</div>
                                    }
                                    @if (param.IsDeprecated)
                                    {
                                        <span class="badge bg-warning">⚠️ Deprecated</span>
                                    }
                                </div>
                                @if (!alreadyAdded)
                                {
                                    <form method="post" asp-page-handler="AddParameter" style="display:inline">
                                        <input type="hidden" name="id" value="@Model.Feature?.Id" />
                                        <input type="hidden" name="parameterId" value="@param.Id" />
                                        <button type="submit" class="btn btn-sm btn-success">+ Add</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Added</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Simple parameter search
        document.getElementById('parameterSearch')?.addEventListener('input', function(e) {
            const search = e.target.value.toLowerCase();
            const items = document.querySelectorAll('#addParameterModal .list-group-item');
            items.forEach(item => {
                const text = item.textContent.toLowerCase();
                item.style.display = text.includes(search) ? '' : 'none';
            });
        });
    </script>
}
