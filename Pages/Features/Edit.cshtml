                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-sm btn-outline-danger w-100" onclick="this.closest('.loop-variable-row').remove()">🗑️</button>
                </div>
            `;
            container.appendChild(newRow);
        }
        
        function addConditionGroup() {
            const container = document.getElementById('exitConditionsContainer');
            const groupCount = container.querySelectorAll('.condition-group').length + 1;
            const newGroup = document.createElement('div');
            newGroup.className = 'condition-group mb-3 p-2 border rounded';
            newGroup.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <span class="badge bg-warning me-2">OR</span>
                        <span class="badge bg-info">Condition Group ${groupCount}</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.condition-group').remove()">Remove Group</button>
                </div>
                <div class="condition-row mb-2">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-3">
                            <select class="form-select form-select-sm" onchange="updateConditionSource(this)">
                                <option value="variable">Variable</option>
                                <option value="parameter">Parameter Read</option>
                                <option value="response">Command Response</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select form-select-sm condition-source-select">
                                <option>iterationCount</option>
                                <option>elapsedTime</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select class="form-select form-select-sm">
                                <option>==</option>
                                <option>!=</option>
                                <option>&gt;</option>
                                <option>&gt;=</option>
                                <option>&lt;</option>
                                <option>&lt;=</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <input type="text" class="form-control form-control-sm" placeholder="Value">
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.condition-row').remove()">🗑️</button>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addConditionToGroup(this, 'AND')">+ AND</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addConditionToGroup(this, 'OR')">+ OR</button>
                </div>
            `;
            container.appendChild(newGroup);
        }
        
        function addConditionToGroup(button, logicOp) {
            const group = button.closest('.condition-group');
            const buttonContainer = button.parentElement;
            const newRow = document.createElement('div');
            newRow.className = 'condition-row mb-2';
            newRow.innerHTML = `
                <div class="row g-2 align-items-center">
                    <div class="col-md-1 text-center">
                        <span class="badge bg-secondary">${logicOp}</span>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm" onchange="updateConditionSource(this)">
                            <option value="variable">Variable</option>
                            <option value="parameter">Parameter</option>
                            <option value="response">Response</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select form-select-sm condition-source-select">
                            <option>iterationCount</option>
                            <option>elapsedTime</option>
                            <option>lastResponse</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm">
                            <option>==</option>
                            <option>!=</option>
                            <option>&gt;</option>
                            <option>&gt;=</option>
                            <option>&lt;</option>
                            <option>&lt;=</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="text" class="form-control form-control-sm" placeholder="Value">
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.condition-row').remove()">🗑️</button>
                    </div>
                </div>
            `;
            group.insertBefore(newRow, buttonContainer);
        }
        
        function updateConditionSource(select) {
            const row = select.closest('.condition-row');
            const sourceSelect = row.querySelector('.condition-source-select');
            
            const options = {
                'variable': ['iterationCount', 'elapsedTime', 'lastResponse', 'customVar'],
                'parameter': ['DfuMode', 'ParcelSizeBytes', 'ValidationMethod', 'DirectionalityMode'],
                'response': ['lastCommandResponse', 'statusCode', 'errorCode']
            };
            
            const newOptions = options[select.value] || [];
            sourceSelect.innerHTML = newOptions.map(opt => `<option>${opt}</option>`).join('');
        }
        
        function editLoopConfiguration(operationId) {
            // Would show a detailed loop configuration modal
            showToast(`Edit loop configuration for operation ${operationId}`, 'info');
        }
    </script>
}
