@page
@model WebApp.Pages.Features.IndexModel
@{
    ViewData["Title"] = "Features";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col">
            <h2>Features</h2>
        </div>
        <div class="col-auto">
            <a href="/Features/Create" class="btn btn-primary">+ New Feature</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom-0 py-3">
            <div class="d-flex align-items-center">
                <h5 class="mb-0 text-primary me-2"><i class="bi bi-list-task"></i> Feature Library</h5>
                <span class="badge bg-light text-dark border">@Model.Features.Count Items</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Feature Name</th>
                        <th>Description</th>
                        <th class="text-center">Complexity</th>
                        <th>Last Modified</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var feature in Model.Features)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@feature.Name</div>
                                <div class="small text-muted"><i class="bi bi-person-circle me-1"></i>@feature.Owner</div>
                            </td>
                            <td style="max-width: 300px;">
                                <div class="text-truncate" title="@feature.Description">@feature.Description</div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-secondary border me-1" title="Parameters">
                                    <i class="bi bi-sliders me-1"></i>@(feature.Parameters?.Count ?? 0)
                                </span>
                                <span class="badge bg-light text-secondary border" title="Commands">
                                    <i class="bi bi-terminal me-1"></i>@(feature.Commands?.Count ?? 0)
                                </span>
                            </td>
                            <td>
                                <div>@feature.ModifiedAt.ToString("MMM dd, yyyy")</div>
                                <div class="small text-muted">@feature.ModifiedAt.ToString("HH:mm")</div>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a href="/Workflow/Visualize?id=@feature.Id&returnUrl=/Features/Index" class="btn btn-sm btn-outline-info" title="View Operational Flow">
                                        <i class="bi bi-diagram-3-fill"></i> Flow
                                    </a>
                                    <a href="/Features/Edit?id=@feature.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* AI Chat Panel *@
@await Html.PartialAsync("_ChatPanel", Model.FeaturesChatContext)
